<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="UTF-8">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="manifest" href="/site.webmanifest">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — {{ site.siteName }}</title>
  <meta name="description" content="{{ description or site.siteDescription }}">
  {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="{{ site.siteUrl }}{{ page.url }}">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ title }} — {{ site.siteName }}">
  <meta property="og:description" content="{{ description or site.siteDescription }}">
  <meta property="og:url" content="{{ site.siteUrl }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="es_ES">

  <!-- Schema.org -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "{{ title }}",
    "description": "{{ description or site.siteDescription }}",
    "url": "{{ site.siteUrl }}{{ page.url }}",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" }
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-9RPZFQTQCL"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-9RPZFQTQCL');
  </script>

</head>
<body>

{% set isEN = true if page.url and ("/en/" in page.url) else false %}

<header class="site-header">
  <div class="container header-inner">

    <a href="{{ '/en/' if isEN else '/' }}" class="logo">Calc<span>Fácil</span></a>

    <!-- Selector de idioma -->
    <div style="display:flex;gap:0.25rem;margin-left:0.5rem;flex-shrink:0">
      <a href="/" title="Español" style="font-size:1.1rem;padding:0.2rem 0.4rem;border-radius:6px;border:1px solid var(--border);text-decoration:none;line-height:1.4;opacity:{{ '1' if not isEN else '0.4' }}">🇪🇸</a>
      <a href="/en/" title="English" style="font-size:1.1rem;padding:0.2rem 0.4rem;border-radius:6px;border:1px solid var(--border);text-decoration:none;line-height:1.4;opacity:{{ '1' if isEN else '0.4' }}">🇬🇧</a>
    </div>

    {% if isEN %}
    <nav class="main-nav" aria-label="Main navigation">
      <a href="/en/calculators/health/">🏥 Health</a>
      <a href="/en/calculators/fitness/">💪 Fitness</a>
      <a href="/en/calculators/math/">🔢 Math</a>
      <a href="/en/calculators/everyday/">🌤 Everyday</a>
      <a href="/en/calculators/finance/">💶 Finance</a>
      <a href="/en/calculators/home/">🏠 Home</a>
    </nav>
    {% else %}
    <nav class="main-nav" aria-label="Navegación principal">
      <a href="/calculadoras/salud/">🏥 Salud</a>
      <a href="/calculadoras/fitness/">💪 Fitness</a>
      <a href="/calculadoras/unidades/">📐 Unidades</a>
      <a href="/calculadoras/dia-a-dia/">🧮 Día a día</a>
      <a href="/calculadoras/finanzas/">💶 Finanzas</a>
      <a href="/calculadoras/matematicas/">🔢 Matemáticas</a>
    </nav>
    {% endif %}

    <button class="nav-toggle" aria-label="Abrir menú" onclick="document.querySelector('.main-nav').classList.toggle('open')">☰</button>
    <button class="dark-toggle" id="dark-btn" aria-label="Cambiar tema" onclick="toggleDark()">🌙</button>

  </div>
</header>

<main>
  {{ content | safe }}
</main>

{% if isEN %}
<footer class="site-footer">
  <div class="container footer-inner">
    <p>© {{ site.siteName }} 2026 · Free calculators · No ads</p>
    <nav aria-label="Footer navigation">
      <a href="/en/calculators/health/">Health</a>
      <a href="/en/calculators/finance/">Finance</a>
      <a href="/en/calculators/everyday/">Everyday</a>
      <a href="/en/calculators/math/">Math</a>
    </nav>
  </div>
</footer>
{% else %}
<footer class="site-footer">
  <div class="container footer-inner">
    <p>© {{ site.siteName }} {{ "" | fecha if false else 2026 }} · Calculadoras gratuitas · Sin anuncios</p>
    <nav aria-label="Pie de página">
      <a href="/calculadoras/salud/">Salud</a>
      <a href="/calculadoras/unidades/">Unidades</a>
      <a href="/calculadoras/dia-a-dia/">Día a día</a>
      <a href="/calculadoras/finanzas/">Finanzas</a>
    </nav>
  </div>
</footer>
{% endif %}

<script src="/js/calculadoras.js"></script>

<script>
function toggleDark() {
  const html = document.documentElement;
  const isDark = html.getAttribute('data-theme') === 'dark';
  html.setAttribute('data-theme', isDark ? 'light' : 'dark');
  localStorage.setItem('calcfacil-theme', isDark ? 'light' : 'dark');
  document.getElementById('dark-btn').textContent = isDark ? '🌙' : '☀️';
}

(function() {
  const saved = localStorage.getItem('calcfacil-theme');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  const theme = saved || (prefersDark ? 'dark' : 'light');
  document.documentElement.setAttribute('data-theme', theme);
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('dark-btn');
    if (btn) btn.textContent = theme === 'dark' ? '☀️' : '🌙';
  });
})();
</script>

</body>
</html>