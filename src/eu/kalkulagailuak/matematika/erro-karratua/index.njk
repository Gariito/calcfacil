<script>
function toggleErr() {
  document.getElementById('err-exp-wrap').style.display =
    document.getElementById('err-op').value === 'berN' ? 'block' : 'none';
  calcErr();
}
function calcErr() {
  const n = parseFloat(document.getElementById('err-num').value);
  const op = document.getElementById('err-op').value;
  if (isNaN(n)) return;
  let r, etiketa;
  if (op==='erro2') { r=Math.sqrt(n); etiketa=`√${n}`; }
  else if (op==='erro3') { r=Math.cbrt(n); etiketa=`∛${n}`; }
  else if (op==='ber2') { r=n*n; etiketa=`${n}²`; }
  else if (op==='ber3') { r=n*n*n; etiketa=`${n}³`; }
  else {
    const exp = parseFloat(document.getElementById('err-exp').value);
    if (isNaN(exp)) return;
    r=Math.pow(n,exp); etiketa=`${n}^${exp}`;
  }
  document.getElementById('err-res').innerHTML =
    isNaN(r) ? 'Ezin da kalkulatu sarrera honekin' :
    `${etiketa} = ${parseFloat(r.toFixed(10)).toLocaleString('es-ES',{maximumFractionDigits:8})}`;
}
</script>