<script>
function calcBB() {
  const raw = document.getElementById('bb-nums').value;
  const nums = raw.split(/[\s,;]+/).map(Number).filter(n => !isNaN(n) && raw.trim()!=='');
  if (nums.length < 2) return;
  const ordenatuta = [...nums].sort((a,b)=>a-b);
  const n = nums.length;
  const batezBesteko = nums.reduce((a,b)=>a+b,0)/n;
  const mediana = n%2===0?(ordenatuta[n/2-1]+ordenatuta[n/2])/2:ordenatuta[Math.floor(n/2)];
  const maiztasuna = {};
  nums.forEach(v=>maiztasuna[v]=(maiztasuna[v]||0)+1);
  const maxMaiz = Math.max(...Object.values(maiztasuna));
  const moda = Object.keys(maiztasuna).filter(k=>maiztasuna[k]===maxMaiz).join(', ');
  const barrutia = ordenatuta[n-1]-ordenatuta[0];
  const varianza = nums.reduce((a,b)=>a+Math.pow(b-batezBesteko,2),0)/n;
  const desbEstandar = Math.sqrt(varianza);

  document.getElementById('bb-res').innerHTML =
    `Batez bestekoa: ${batezBesteko.toFixed(4)}<small>Mediana: ${mediana} · Moda: ${moda} · Barrutia: ${barrutia}</small>`;

  document.getElementById('bb-stats').innerHTML = `
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.3rem;font-weight:700;color:var(--accent)">${batezBesteko.toFixed(4)}</div>
      <div style="font-size:0.8rem;color:var(--muted)">Batez bestekoa</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.3rem;font-weight:700;color:var(--accent)">${mediana}</div>
      <div style="font-size:0.8rem;color:var(--muted)">Mediana</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.3rem;font-weight:700;color:var(--accent)">${moda}</div>
      <div style="font-size:0.8rem;color:var(--muted)">Moda</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.3rem;font-weight:700;color:var(--accent)">${barrutia}</div>
      <div style="font-size:0.8rem;color:var(--muted)">Barrutia</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.3rem;font-weight:700;color:var(--accent)">${desbEstandar.toFixed(4)}</div>
      <div style="font-size:0.8rem;color:var(--muted)">Desbiderapena</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.3rem;font-weight:700;color:var(--accent)">${n}</div>
      <div style="font-size:0.8rem;color:var(--muted)">Datu kopurua</div>
    </div>`;
}
</script>