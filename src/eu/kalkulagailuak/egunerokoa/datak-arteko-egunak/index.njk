<script>
document.addEventListener('DOMContentLoaded', () => {
  const gaur = new Date().toISOString().split('T')[0];
  document.getElementById('dat-has').value = gaur;
});
function calcDatak() {
  const has = document.getElementById('dat-has').value;
  const ama = document.getElementById('dat-ama').value;
  const lan = document.getElementById('dat-lan').value;
  if (!has||!ama) return;
  const d1 = new Date(has), d2 = new Date(ama);
  const diff = Math.round((d2-d1)/86400000);
  if (diff < 0) { document.getElementById('dat-res').textContent='Amaiera data hasiera data baino lehenagokoa da'; return; }
  let lanEgunak = 0;
  if (lan==='bai') {
    let cur = new Date(d1);
    while (cur < d2) {
      const dow = cur.getDay();
      if (dow!==0&&dow!==6) lanEgunak++;
      cur.setDate(cur.getDate()+1);
    }
  }
  const asteak = Math.floor(diff/7), gainerakoak = diff%7;
  const hilabeteak = Math.floor(diff/30.44);
  document.getElementById('dat-res').innerHTML =
    `${diff} egun
    <small>${asteak} aste eta ${gainerakoak} egun · ~${hilabeteak} hilabete${lan==='bai'?' · '+lanEgunak+' lan egun':''}</small>`;
}
</script>