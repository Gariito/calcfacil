          </ul>
        </div>
      </aside>
    </div>
  </div>
</div>

<script>
function calcEh1() {
  const p = parseFloat(document.getElementById('eh1-pct').value);
  const v = parseFloat(document.getElementById('eh1-val').value);
  if (isNaN(p)||isNaN(v)) return;
  const r = v*p/100;
  document.getElementById('eh1-res').innerHTML =
    `${v}-ren %${p} = ${parseFloat(r.toFixed(6)).toLocaleString('es-ES',{maximumFractionDigits:4})}`;
}
function calcEh2() {
  const x = parseFloat(document.getElementById('eh2-x').value);
  const y = parseFloat(document.getElementById('eh2-y').value);
  if (isNaN(x)||isNaN(y)||y===0) return;
  document.getElementById('eh2-res').innerHTML =
    `${x} zenbakia ${y}-ren <strong>%${(x/y*100).toFixed(4)}</strong> da`;
}
function calcEh3() {
  const x = parseFloat(document.getElementById('eh3-x').value);
  const y = parseFloat(document.getElementById('eh3-y').value);
  if (isNaN(x)||isNaN(y)||x===0) return;
  const ald = (y-x)/Math.abs(x)*100;
  const dir = ald>=0?'▲ igoera':'▼ jaitsiera';
  const color = ald>=0?'#22C55E':'#EF4444';
  document.getElementById('eh3-res').innerHTML =
    `<span style="color:${color}">%${Math.abs(ald).toFixed(4)} ${dir}</span>
    <small>${x}-tik ${y}-era · Diferentzia: ${ald>=0?'+':''}${(y-x).toFixed(4)}</small>`;
}
</script>