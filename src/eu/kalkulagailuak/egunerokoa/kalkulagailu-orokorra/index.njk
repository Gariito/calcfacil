<script>
let cb = { v:'0', expr:'', op:null, newN:true };
function cbDisp() {
  document.getElementById('calc-val').textContent = cb.v;
  document.getElementById('calc-expr').textContent = cb.expr;
}
function cbNum(d) {
  if (cb.newN) { cb.v = d; cb.newN = false; }
  else cb.v = cb.v === '0' ? d : cb.v + d;
  cbDisp();
}
function cbDot() {
  if (!cb.v.includes('.') && !cb.v.includes(',')) {
    cb.v += ','; cb.newN = false;
  }
  cbDisp();
}
function cbAc() { cb = {v:'0',expr:'',op:null,newN:true}; cbDisp(); }
function cbOp(o) {
  if (o==='+/-') { cb.v = String(-(parseFloat(cb.v.replace(',','.'))||0)).replace('.',','); cbDisp(); return; }
  if (o==='%') { cb.v = String(parseFloat(cb.v.replace(',','.'))/100).replace('.',','); cbDisp(); return; }
  cbEq();
  cb.op = o; cb.expr = cb.v+' '+o; cb.newN = true; cbDisp();
}
function cbEq() {
  if (!cb.op) return;
  const a = parseFloat(cb.expr.replace(',','.'));
  const b = parseFloat(cb.v.replace(',','.'));
  let r;
  if (cb.op==='+') r=a+b;
  else if (cb.op==='−') r=a-b;
  else if (cb.op==='×') r=a*b;
  else r=b!==0?a/b:'Errorea';
  cb.expr = cb.expr+' '+cb.v+' =';
  cb.v = typeof r==='number'
    ? String(parseFloat(r.toFixed(10))).replace('.',',')
    : r;
  cb.op=null; cb.newN=true; cbDisp();
}
document.addEventListener('keydown', e => {
  if ('0123456789'.includes(e.key)) cbNum(e.key);
  else if (e.key==='.' || e.key===',') cbDot();
  else if (e.key==='Enter'||e.key==='=') cbEq();
  else if (e.key==='+') cbOp('+');
  else if (e.key==='-') cbOp('−');
  else if (e.key==='*') cbOp('×');
  else if (e.key==='/') { e.preventDefault(); cbOp('÷'); }
  else if (e.key==='Escape') cbAc();
  else if (e.key==='Backspace') {
    cb.v=cb.v.length>1?cb.v.slice(0,-1):'0'; cbDisp();
  }
});
</script>