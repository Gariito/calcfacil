<script>
function calcAdin() {
  const val = document.getElementById('adin-data').value;
  if (!val) return;
  const gaur = new Date();
  const jaio = new Date(val);
  if (jaio > gaur) { document.getElementById('adin-res').textContent = 'Data etorkizunekoa da'; return; }

  let urteak = gaur.getFullYear() - jaio.getFullYear();
  let hilabeteak = gaur.getMonth() - jaio.getMonth();
  let egunak = gaur.getDate() - jaio.getDate();

  if (egunak < 0) { hilabeteak--; egunak += new Date(gaur.getFullYear(), gaur.getMonth(), 0).getDate(); }
  if (hilabeteak < 0) { urteak--; hilabeteak += 12; }

  const hurrengoBetetzea = new Date(gaur.getFullYear(), jaio.getMonth(), jaio.getDate());
  if (hurrengoBetetzea < gaur) hurrengoBetetzea.setFullYear(gaur.getFullYear() + 1);
  const egunakBetetzea = Math.round((hurrengoBetetzea - gaur) / 86400000);
  const bizitakoEgunak = Math.round((gaur - jaio) / 86400000);
  const bizitakoAsteak = Math.floor(bizitakoEgunak / 7);

  document.getElementById('adin-res').innerHTML =
    `${urteak} urte, ${hilabeteak} hilabete eta ${egunak} egun
    <small>${bizitakoEgunak.toLocaleString('es-ES')} egun bizita · Hurrengo urtebetetzea ${egunakBetetzea} egunera</small>`;

  document.getElementById('adin-stats').innerHTML = `
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.3rem;font-weight:700;color:var(--accent)">${urteak}</div>
      <div style="font-size:0.8rem;color:var(--muted)">Urteak</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.3rem;font-weight:700;color:var(--accent)">${hilabeteak}</div>
      <div style="font-size:0.8rem;color:var(--muted)">Hilabeteak (urtea osatu ondoren)</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.3rem;font-weight:700;color:var(--accent)">${bizitakoEgunak.toLocaleString('es-ES')}</div>
      <div style="font-size:0.8rem;color:var(--muted)">Bizitako egunak</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.3rem;font-weight:700;color:var(--accent)">${bizitakoAsteak.toLocaleString('es-ES')}</div>
      <div style="font-size:0.8rem;color:var(--muted)">Bizitako asteak</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.3rem;font-weight:700;color:var(--accent)">${egunakBetetzea}</div>
      <div style="font-size:0.8rem;color:var(--muted)">Egun hurrengo urtebetetzeraino</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.3rem;font-weight:700;color:var(--accent)">${jaio.getFullYear()}</div>
      <div style="font-size:0.8rem;color:var(--muted)">Jaiotze urtea</div>
    </div>`;
}
</script>