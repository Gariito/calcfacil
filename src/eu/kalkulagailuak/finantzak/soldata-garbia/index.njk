<script>
function calcSG() {
  const gordin = parseFloat(document.getElementById('sg-gordin').value);
  const egoera = parseInt(document.getElementById('sg-egoera').value);
  if (!gordin) return;

  const gs = gordin * 0.0635;
  const minPertsonala = 5550;
  const minFamilia = [0,0,2400,4800,8000][egoera]||0;
  const minEzkontide = egoera===1?2550:0;
  const oinarria = Math.max(0, gordin-gs-minPertsonala-minFamilia-minEzkontide);

  const tramoak = [[12450,0.19],[20200,0.24],[35200,0.30],[60000,0.37],[300000,0.45],[Infinity,0.47]];
  let pfez=0, gelditzen=oinarria, aurrekoa=0;
  for (const [arte,tasa] of tramoak) {
    if (gelditzen<=0) break;
    const tartea=Math.min(gelditzen,arte-aurrekoa);
    pfez+=tartea*tasa; gelditzen-=tartea; aurrekoa=arte;
  }

  const garbia = gordin-gs-pfez;
  document.getElementById('sg-res').innerHTML =
    `Soldata garbia: ${(garbia/12).toFixed(2).replace('.',',')} €/hileko
    <small>
    Urteko garbia: ${garbia.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g,'.')} € · 
    PFEZ: ${pfez.toFixed(0)} € · 
    GS: ${gs.toFixed(0)} €
    </small>`;
}
</script>