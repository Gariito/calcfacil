        </div>
      </aside>
    </div>
  </div>
</div>

<script>
function calcML() {
  const zenbat = parseFloat(document.getElementById('ml-zenbat').value);
  const tasa = parseFloat(document.getElementById('ml-tasa').value);
  const urte = parseFloat(document.getElementById('ml-urte').value);
  if (!zenbat||!tasa||!urte) return;
  const r = tasa/100/12, n = urte*12;
  const kuota = zenbat*r*Math.pow(1+r,n)/(Math.pow(1+r,n)-1);
  const guztira = kuota*n;
  const interesak = guztira-zenbat;
  const fmt = n => n.toFixed(2).replace('.',',').replace(/\B(?=(\d{3})+(?!\d))/g,'.')+' €';
  document.getElementById('ml-res').innerHTML =
    `Hileko kuota: ${fmt(kuota)}
    <small>
    Guztirako ordainketa: ${fmt(guztira)} · 
    Interesak: ${fmt(interesak)} · 
    ${n} hilabete
    </small>`;
}
</script>