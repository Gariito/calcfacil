    </div>
  </div>
</div>

<script>
function calcIK() {
  const kapital = parseFloat(document.getElementById('ik-kapital').value);
  const tasa = parseFloat(document.getElementById('ik-tasa').value);
  const urte = parseFloat(document.getElementById('ik-urte').value);
  const ekarpen = parseFloat(document.getElementById('ik-ekarpen').value)||0;
  if (!kapital||!tasa||!urte) return;
  const r = tasa/100/12, n = urte*12;
  const etorkizuna = kapital*Math.pow(1+r,n) + ekarpen*(Math.pow(1+r,n)-1)/r;
  const inbertitua = kapital + ekarpen*n;
  const irabaziak = etorkizuna - inbertitua;
  const fmt = n => n.toFixed(2).replace('.',',').replace(/\B(?=(\d{3})+(?!\d))/g,'.')+' €';
  document.getElementById('ik-res').innerHTML =
    `Azken kapitala: ${fmt(etorkizuna)}
    <small>
    Inbertitua: ${fmt(inbertitua)} · 
    Irabaziak: ${fmt(irabaziak)} · 
    Hazkundea: %${((etorkizuna/inbertitua-1)*100).toFixed(1).replace('.',',')}
    </small>`;
}
</script>