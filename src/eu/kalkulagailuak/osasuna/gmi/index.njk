<script>
function calcGMI() {
  const pisu = parseFloat(document.getElementById('gmi-pisu').value);
  const altu = parseFloat(document.getElementById('gmi-altuera').value);
  const adin = parseFloat(document.getElementById('gmi-adin').value)||30;
  const sexu = document.getElementById('gmi-sexu').value;
  if (!pisu||!altu) return;
  const altM = altu/100;
  const gmi = pisu/(altM*altM);
  let kat, kol;
  if (gmi<18.5){kat='Pisu txikia';kol='#3B82F6';}
  else if (gmi<25){kat='Pisu normala ✓';kol='#22C55E';}
  else if (gmi<30){kat='Gehiegizko pisua';kol='#EAB308';}
  else if (gmi<35){kat='I. mailako obesitatea';kol='#EF4444';}
  else if (gmi<40){kat='II. mailako obesitatea';kol='#DC2626';}
  else{kat='III. mailako obesitatea';kol='#7C3AED';}
  const posPct = Math.min(Math.max((gmi-15)/25*100,0),100);
  document.getElementById('gmi-marker').style.left = posPct+'%';
  const pisuMin = (18.5*altM*altM).toFixed(1);
  const pisuMax = (24.9*altM*altM).toFixed(1);
  document.getElementById('gmi-res').innerHTML =
    `GMI: <span style="color:${kol}">${gmi.toFixed(1)} — ${kat}</span>
    <small>Pisu osasuntsua zure altuerarako: ${pisuMin}–${pisuMax} kg</small>`;
  document.getElementById('gmi-stats').innerHTML = `
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.3rem;font-weight:700;color:${kol}">${gmi.toFixed(1)}</div>
      <div style="font-size:0.8rem;color:var(--muted)">GMI balioa</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.1rem;font-weight:700;color:${kol}">${kat}</div>
      <div style="font-size:0.8rem;color:var(--muted)">Kategoria</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.3rem;font-weight:700;color:var(--accent)">${pisuMin}–${pisuMax} kg</div>
      <div style="font-size:0.8rem;color:var(--muted)">Pisu osasuntsua</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.3rem;font-weight:700;color:var(--accent)">${altu} cm</div>
      <div style="font-size:0.8rem;color:var(--muted)">Altuera</div>
    </div>`;
}
</script>