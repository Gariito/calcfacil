<script>
function calcBM() {
  const adin = parseFloat(document.getElementById('bm-adin').value);
  const sexu = document.getElementById('bm-sexu').value;
  const atse = parseFloat(document.getElementById('bm-atse').value)||60;
  if (!adin) return;
  const bmmax = sexu==='g' ? 220-adin : 226-adin;
  const karvonen = pct => Math.round(atse+(bmmax-atse)*pct);
  document.getElementById('bm-res').innerHTML =
    `BM maximoa: ${bmmax} taupada/min
    <small>Gune aerobikoa (Karvonen): ${karvonen(0.6)}–${karvonen(0.8)} t/min · Atsedenekoa: ${atse} t/min</small>`;
  document.getElementById('bm-guneak').style.display = 'block';
  const guneak = [
    ['1 — Berreskurapen aktiboa','50-60%',karvonen(0.5),karvonen(0.6),'#3B82F6'],
    ['2 — Koipe-erretzea','60-70%',karvonen(0.6),karvonen(0.7),'#22C55E'],
    ['3 — Gune aerobikoa','70-80%',karvonen(0.7),karvonen(0.8),'#EAB308'],
    ['4 — Muga anaerobikoa','80-90%',karvonen(0.8),karvonen(0.9),'#F97316'],
    ['5 — Ahalegин maximoa','90-100%',karvonen(0.9),bmmax,'#EF4444'],
  ];
  document.getElementById('bm-guneak').innerHTML = `
    <div style="display:flex;flex-direction:column;gap:0.5rem">
      ${guneak.map(([izen,pct,min,max,kol])=>`
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:0.75rem;display:flex;justify-content:space-between;align-items:center">
          <div>
            <span style="font-weight:600;font-size:0.875rem">${izen}</span>
            <span style="color:var(--muted);font-size:0.78rem;margin-left:0.5rem">${pct}</span>
          </div>
          <div style="font-weight:700;color:${kol}">${min}–${max} t/min</div>
        </div>`).join('')}
    </div>`;
}
</script>