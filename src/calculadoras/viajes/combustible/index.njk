<div class="row-2">
  <div>
    <label>Distancia del trayecto (km)</label>
    <input type="number" id="comb-km" value="300" placeholder="300" oninput="calcComb()">
  </div>
  <div>
    <label>Consumo del coche (L/100km)</label>
    <input type="number" id="comb-cons" value="6.5" placeholder="6.5" step="0.1" oninput="calcComb()">
  </div>
</div>

<div class="row-2">
  <div>
    <label>Precio del combustible (€/L)</label>
    <input type="number" id="comb-precio" value="1.60" placeholder="1.60" step="0.01" oninput="calcComb()">
  </div>
  <div>
    <label>Número de personas (para dividir)</label>
    <input type="number" id="comb-pax" value="1" placeholder="1" min="1" oninput="calcComb()">
  </div>
</div>

<div class="result-box" id="comb-res">Introduce los datos del trayecto</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  calcComb();
});

function calcComb() {
  const km = parseFloat(document.getElementById('comb-km').value) || 0;
  const cons = parseFloat(document.getElementById('comb-cons').value) || 0;
  const precio = parseFloat(document.getElementById('comb-precio').value) || 0;
  const pax = parseInt(document.getElementById('comb-pax').value) || 1;

  if (km <= 0 || cons <= 0 || precio <= 0) {
    document.getElementById('comb-res').innerHTML = "Introduce los datos del trayecto";
    return;
  }

  const litros = (km * cons) / 100;
  const costeTotal = litros * precio;
  const costePax = costeTotal / pax;
  const costeKm = costeTotal / km;

  let htmlPax = pax > 1 
    ? `<br><strong style="color:var(--accent);font-size:1.1rem">${costePax.toFixed(2)} € / persona</strong> (${pax} pasajeros)` 
    : '';

  document.getElementById('comb-res').innerHTML =
    `${costeTotal.toFixed(2)} € total ${htmlPax}
    <small>
    Litros necesarios: ${litros.toFixed(1)} L · Coste por km: ${costeKm.toFixed(3)} €/km
    </small>`;
}
</script>

