<div class="calc-display">
  <div class="expr" id="cb-expr"></div>
  <div class="val" id="cb-val">0</div>
</div>

<div class="kbd-grid">
  <button class="clr" onclick="cbAc()">AC</button>
  <button class="op" onclick="cbOp('+/-')">+/-</button>
  <button class="op" onclick="cbOp('%')">%</button>
  <button class="op" onclick="cbOp('÷')">÷</button>

  <button onclick="cbNum('7')">7</button>
  <button onclick="cbNum('8')">8</button>
  <button onclick="cbNum('9')">9</button>
  <button class="op" onclick="cbOp('×')">×</button>

  <button onclick="cbNum('4')">4</button>
  <button onclick="cbNum('5')">5</button>
  <button onclick="cbNum('6')">6</button>
  <button class="op" onclick="cbOp('−')">−</button>

  <button onclick="cbNum('1')">1</button>
  <button onclick="cbNum('2')">2</button>
  <button onclick="cbNum('3')">3</button>
  <button class="op" onclick="cbOp('+')">+</button>

  <button style="grid-column:span 2" onclick="cbNum('0')">0</button>
  <button onclick="cbDot()">.</button>
  <button class="eq" onclick="cbEq()">=</button>
</div>

<script>
let cb = {
  v: '0',
  expr: '',
  op: null,
  newN: true,
  first: null
};

function cbDisp() {
  document.getElementById('cb-val').textContent = cb.v;
  document.getElementById('cb-expr').textContent = cb.expr;
}

function cbNum(d) {
  if (cb.newN) {
    cb.v = d;
    cb.newN = false;
  } else {
    cb.v = cb.v === '0' ? d : cb.v + d;
  }

  cbDisp();
}

function cbDot() {
  if (cb.newN) {
    cb.v = '0.';
    cb.newN = false;
  } else if (!cb.v.includes('.')) {
    cb.v += '.';
  }

  cbDisp();
}

function cbAc() {
  cb = {
    v: '0',
    expr: '',
    op: null,
    newN: true,
    first: null
  };

  cbDisp();
}

function cbOp(o) {

  if (o === '+/-') {
    const n = parseFloat(cb.v);

    if (!isNaN(n)) {
      cb.v = String(-n);
    }

    cbDisp();
    return;
  }

  if (o === '%') {

    const percentage = parseFloat(cb.v);

    if (isNaN(percentage)) return;

    /*
     * Si existe una operación pendiente:
     *
     * 200 × 15 %  → 30
     * 100 + 21 %  → 121
     * 100 − 21 %  → 79
     *
     * Si no existe una operación:
     *
     * 20 % → 0.2
     */

    if (cb.op && cb.first !== null) {

      if (cb.op === '×' || cb.op === '÷') {
        cb.v = String(cb.first * (percentage / 100));

      } else if (cb.op === '+' || cb.op === '−') {
        cb.v = String(cb.first * (percentage / 100));
      }

    } else {
      cb.v = String(percentage / 100);
    }

    cb.newN = false;
    cbDisp();
    return;
  }

  if (!cb.newN) {
    cb.first = parseFloat(cb.v);
  }

  cbEq();

  cb.op = o;
  cb.first = parseFloat(cb.v);
  cb.expr = cb.v + ' ' + o;
  cb.newN = true;

  cbDisp();
}

function cbEq() {

  if (!cb.op) return;

  const a = cb.first !== null
    ? cb.first
    : parseFloat(cb.expr);

  const b = parseFloat(cb.v);

  let r;

  if (cb.op === '+') {
    r = a + b;

  } else if (cb.op === '−') {
    r = a - b;

  } else if (cb.op === '×') {
    r = a * b;

  } else if (cb.op === '÷') {
    r = b !== 0 ? a / b : 'Error';
  }

  cb.expr = cb.expr + ' ' + cb.v + ' =';

  cb.v = typeof r === 'number'
    ? String(parseFloat(r.toFixed(10)))
    : r;

  cb.op = null;
  cb.first = null;
  cb.newN = true;

  cbDisp();
}

document.addEventListener('keydown', e => {

  if ('0123456789'.includes(e.key)) {
    cbNum(e.key);

  } else if (e.key === '.') {
    cbDot();

  } else if (e.key === 'Enter' || e.key === '=') {
    cbEq();

  } else if (e.key === '+') {
    cbOp('+');

  } else if (e.key === '-') {
    cbOp('−');

  } else if (e.key === '*') {
    cbOp('×');

  } else if (e.key === '/') {
    e.preventDefault();
    cbOp('÷');

  } else if (e.key === 'Escape') {
    cbAc();

  } else if (e.key === 'Backspace') {

    if (!cb.newN) {
      cb.v = cb.v.length > 1
        ? cb.v.slice(0, -1)
        : '0';

      cbDisp();
    }
  }
});
</script>

<div style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border)">

