<div class="row-2">
  <div>
    <label>Fecha de inicio</label>
    <input
      type="date"
      id="df-inicio"
      oninput="calcDias()"
      style="width:100%;padding:0.65rem 0.9rem;border:1px solid var(--border);border-radius:8px;font-size:1rem;background:var(--bg);margin-bottom:1rem"
    >
  </div>

  <div>
    <label>Fecha de fin</label>
    <input
      type="date"
      id="df-fin"
      oninput="calcDias()"
      style="width:100%;padding:0.65rem 0.9rem;border:1px solid var(--border);border-radius:8px;font-size:1rem;background:var(--bg);margin-bottom:1rem"
    >
  </div>
</div>

<label>¿Quieres contar solo días laborables?</label>
<select id="df-laborables" onchange="calcDias()">
  <option value="no">No, contar todos los días</option>
  <option value="si">Sí, solo días laborables (lunes a viernes)</option>
</select>

<div class="result-box" id="df-res">
  Introduce las dos fechas
</div>

<div style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border)">

  <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem">
    ¿Para qué sirve calcular los días entre fechas?
  </h2>

  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">
    Calcular la diferencia entre dos fechas puede ser útil para saber cuánto
    tiempo ha pasado desde un acontecimiento, cuánto falta para una fecha
    concreta o cuánto dura un determinado período.
  </p>

  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">
    Por ejemplo, puedes utilizarla para contar los días que faltan para un
    viaje, una boda o unas vacaciones, calcular la duración de un proyecto
    o conocer el tiempo transcurrido entre dos acontecimientos.
  </p>

  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8">
    La opción de días laborables permite excluir los sábados y domingos.
    Puede resultar útil para estimar la duración de tareas o períodos de
    trabajo en los que solo cuentan los días de lunes a viernes.
  </p>

  <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin:1.5rem 0 1rem">
    Ejemplo de cálculo
  </h2>

  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">
    Si quieres saber cuántos días hay entre el 1 de enero y el 1 de febrero,
    introduce ambas fechas. La calculadora mostrará la diferencia exacta en
    días y su equivalente aproximado en semanas y meses.
  </p>

  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8">
    Para calcular únicamente los días laborables, selecciona
    <strong>solo días laborables (lunes a viernes)</strong>. Los sábados y
    domingos no se incluirán en el resultado.
  </p>

  <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin:1.5rem 0 1rem">
    Días naturales y días laborables
  </h2>

  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8">
    Los días naturales incluyen todos los días del calendario, incluidos
    sábados, domingos y festivos. En cambio, esta calculadora considera como
    días laborables los días de lunes a viernes y excluye los fines de semana.
    Los festivos no se descuentan automáticamente.
  </p>

</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const hoy = new Date();

  const year = hoy.getFullYear();
  const month = String(hoy.getMonth() + 1).padStart(2, '0');
  const day = String(hoy.getDate()).padStart(2, '0');

  document.getElementById('df-inicio').value =
    `${year}-${month}-${day}`;
});

function calcDias() {
  const ini = document.getElementById('df-inicio').value;
  const fin = document.getElementById('df-fin').value;
  const lab = document.getElementById('df-laborables').value;

  if (!ini || !fin) {
    document.getElementById('df-res').textContent =
      'Introduce las dos fechas';
    return;
  }

  const d1 = new Date(ini + 'T00:00:00');
  const d2 = new Date(fin + 'T00:00:00');

  const diff = Math.round((d2 - d1) / 86400000);

  if (diff < 0) {
    document.getElementById('df-res').textContent =
      'La fecha de fin debe ser posterior a la fecha de inicio';
    return;
  }

  let laborables = 0;

  if (lab === 'si') {
    const cur = new Date(d1);

    while (cur < d2) {
      const dow = cur.getDay();

      if (dow !== 0 && dow !== 6) {
        laborables++;
      }

      cur.setDate(cur.getDate() + 1);
    }
  }

  const semanas = Math.floor(diff / 7);
  const diasResto = diff % 7;

  const mesesAproximados = Math.floor(diff / 30.44);

  let detalle =
    `${semanas} semanas y ${diasResto} días · ~${mesesAproximados} meses`;

  if (lab === 'si') {
    detalle += ` · ${laborables} días laborables`;
  }

  document.getElementById('df-res').innerHTML =
    `${diff} días<small>${detalle}</small>`;
}
</script>