<div style="display:grid;gap:1rem">
  <div>
    <label for="p100g-precio" style="display:block;margin-bottom:.4rem;font-weight:600">Precio del producto (€)</label>
    <input id="p100g-precio" type="number" step="0.01" min="0" placeholder="Ej. 4,50"
      style="width:100%;padding:.75rem;border:1px solid var(--border);border-radius:8px;font-size:1rem">
  </div>

  <div>
    <label for="p100g-peso" style="display:block;margin-bottom:.4rem;font-weight:600">Peso del producto (g)</label>
    <input id="p100g-peso" type="number" step="0.01" min="0" placeholder="Ej. 500"
      style="width:100%;padding:.75rem;border:1px solid var(--border);border-radius:8px;font-size:1rem">
  </div>

  <button onclick="calcular100g()"
    style="width:100%;padding:.8rem;border:0;border-radius:8px;background:var(--accent);color:white;font-weight:700;cursor:pointer">
    Calcular precio por 100 g
  </button>

  <div id="p100g-resultado" style="display:none;padding:1rem;background:var(--accent-light);border-radius:8px;text-align:center">
    <div style="font-size:.85rem;color:var(--muted)">Precio por 100 g</div>
    <div id="p100g-valor" style="font-size:1.7rem;font-weight:700;margin-top:.25rem"></div>
  </div>
</div>

<script>
function calcular100g() {
  const precio = parseFloat(document.getElementById('p100g-precio').value);
  const peso = parseFloat(document.getElementById('p100g-peso').value);

  if (!Number.isFinite(precio) || !Number.isFinite(peso) || precio < 0 || peso <= 0) {
    document.getElementById('p100g-resultado').style.display = 'none';
    return;
  }

  const resultado = (precio / peso) * 100;

  document.getElementById('p100g-valor').textContent =
    resultado.toLocaleString('es-ES', {minimumFractionDigits:2, maximumFractionDigits:4}) + ' €';

  document.getElementById('p100g-resultado').style.display = 'block';
}
</script>

<div style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border)">
  <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem">Cómo calcular el precio por 100 gramos</h2>
  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:.75rem">El precio por 100 gramos permite comparar productos que tienen diferentes pesos. En lugar de fijarnos únicamente en el precio del envase, utilizamos una cantidad común para saber cuánto cuesta realmente cada producto.</p>
  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:.75rem">La fórmula es sencilla: divide el precio entre el peso en gramos y multiplica el resultado por 100.</p>

  <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem">Ejemplo</h2>
  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0">Si una bolsa de 400 gramos cuesta 3,20 €, el cálculo es 3,20 ÷ 400 × 100. El resultado es 0,80 €, por lo que el producto cuesta 80 céntimos por cada 100 gramos.</p>
</div>