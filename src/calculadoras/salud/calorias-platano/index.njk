    <tr><td style="padding:0.5rem 0.75rem">Vitamina B6</td><td style="text-align:right">0,37 mg</td><td style="text-align:right">0,47 mg</td></tr>
    <tr style="background:var(--bg)"><td style="padding:0.5rem 0.75rem">Vitamina C</td><td style="text-align:right">8,7 mg</td><td style="text-align:right">11 mg</td></tr>
    <tr><td style="padding:0.5rem 0.75rem">Folato (B9)</td><td style="text-align:right">20 µg</td><td style="text-align:right">25 µg</td></tr>
  </table>
  <p style="color:var(--muted);font-size:0.78rem;margin-top:0.5rem">* Valores medios de referencia para plátano maduro en su punto. Los valores pueden variar según la variedad y el grado de madurez.</p>
</div>

<div style="margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid var(--border)">
  <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem">¿El plátano engorda más que otras frutas?</h2>
  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">El plátano tiene más calorías que frutas como la fresa, la sandía o la naranja, principalmente porque contiene más carbohidratos. Aun así, sigue siendo una fruta bastante normal en cuanto a calorías y puede encajar sin problema en una alimentación variada.</p>
  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">También aporta fibra y potasio, además de resultar bastante fácil de llevar y comer en cualquier sitio. Por eso es una opción habitual tanto para desayunos como para tomar entre comidas.</p>

  <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem;margin-top:1.25rem">Comparativa calórica del plátano con otras frutas</h2>
  <table style="width:100%;font-size:0.825rem;border-collapse:collapse">
    <tr style="background:var(--accent-light)">
      <th style="padding:0.6rem 0.75rem;text-align:left;border-bottom:2px solid var(--accent);color:var(--accent)">Fruta</th>
      <th style="padding:0.6rem 0.75rem;text-align:right;border-bottom:2px solid var(--accent);color:var(--accent)">Calorías por 100g</th>
    </tr>
    <tr><td style="padding:0.5rem 0.75rem">🥑 Aguacate</td><td style="text-align:right">160 kcal</td></tr>
    <tr style="background:var(--bg)"><td style="padding:0.5rem 0.75rem">🍌 Plátano</td><td style="text-align:right"><strong>89 kcal</strong></td></tr>
    <tr><td style="padding:0.5rem 0.75rem">🍇 Uva</td><td style="text-align:right">67 kcal</td></tr>
    <tr style="background:var(--bg)"><td style="padding:0.5rem 0.75rem">🍎 Manzana</td><td style="text-align:right">52 kcal</td></tr>
    <tr><td style="padding:0.5rem 0.75rem">🍊 Naranja</td><td style="text-align:right">47 kcal</td></tr>
    <tr style="background:var(--bg)"><td style="padding:0.5rem 0.75rem">🍓 Fresa</td><td style="text-align:right">32 kcal</td></tr>
    <tr><td style="padding:0.5rem 0.75rem">🍉 Sandía</td><td style="text-align:right">30 kcal</td></tr>
  </table>
</div>

<script>
const PL_KCAL   = 89;
const PL_CARBS  = 22.8;
const PL_AZUCAR = 12.2;
const PL_FIBRA  = 2.6;
const PL_PROT   = 1.1;
const PL_GRASAS = 0.3;
const PL_POTASIO = 358;

function toggleModoPl() {
  const modo = document.getElementById('pl-modo').value;
  document.getElementById('pl-wrap-gramos').style.display   = modo === 'gramos'   ? 'block' : 'none';
  document.getElementById('pl-wrap-tamano').style.display   = modo === 'tamano'   ? 'block' : 'none';
  document.getElementById('pl-wrap-unidades').style.display = modo === 'unidades' ? 'block' : 'none';
  calcPl();
}

function calcPl() {
  const modo     = document.getElementById('pl-modo').value;
  const madurez  = parseFloat(document.getElementById('pl-madurez').value);
  let g = 0;

  if (modo === 'gramos') {
    g = parseFloat(document.getElementById('pl-gramos').value);
  } else if (modo === 'tamano') {
    g = parseFloat(document.getElementById('pl-tamano').value);
  } else {
    const uni    = parseInt(document.getElementById('pl-unidades').value) || 1;
    const tamUni = parseFloat(document.getElementById('pl-tamano-uni').value);
    g = uni * tamUni;
  }

  if (!g || g <= 0) return;

  const kcal    = Math.round(PL_KCAL    * g / 100 * madurez);
  const carbs   = (PL_CARBS   * g / 100 * madurez).toFixed(1);
  const azucar  = (PL_AZUCAR  * g / 100 * madurez).toFixed(1);
  const fibra   = (PL_FIBRA   * g / 100).toFixed(1);
  const prot    = (PL_PROT    * g / 100).toFixed(1);
  const grasas  = (PL_GRASAS  * g / 100).toFixed(1);
  const potasio = Math.round(PL_POTASIO * g / 100);

  const madurezLabel = madurez < 1 ? 'verde' : madurez > 1 ? 'muy maduro' : 'maduro';

  document.getElementById('pl-res').innerHTML =
    `${kcal} kcal - ${g}g de plátano ${madurezLabel}
    <small>Carbohidratos: ${carbs}g · Azúcares: ${azucar}g · Fibra: ${fibra}g · Potasio: ${potasio}mg</small>`;

  document.getElementById('pl-nutri').style.display = 'block';
  document.getElementById('pl-cards').innerHTML = `
    <div style="background:var(--accent-light);border:2px solid var(--accent);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--accent);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Calorías</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${kcal}</div>
      <div style="font-size:0.78rem;color:var(--accent)">kcal</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Carbohidratos</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${carbs}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">de los cuales ${azucar}g azúcares</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Fibra</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${fibra}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">por ${g}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Potasio</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${potasio}mg</div>
      <div style="font-size:0.78rem;color:var(--muted)">por ${g}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Proteínas</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${prot}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">por ${g}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Grasas</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${grasas}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">por ${g}g</div>
    </div>`;
}

calcPl();
</script>