<label>Modo de cálculo</label>
<select id="pl-modo" onchange="toggleModoPl()">
  <option value="gramos">Por gramos de pulpa</option>
  <option value="tamano">Por tamaño del plátano</option>
  <option value="unidades">Por número de plátanos</option>
</select>

<div id="pl-wrap-gramos">
  <label>Gramos de pulpa (sin piel)</label>
  <input type="number" id="pl-gramos" placeholder="105" oninput="calcPl()">
</div>

<div id="pl-wrap-tamano" style="display:none">
  <label>Tamaño del plátano</label>
  <select id="pl-tamano" onchange="calcPl()">
    <option value="81">Pequeño - menos de 18cm (~81g de pulpa)</option>
    <option value="105">Mediano - 18-20cm (~105g de pulpa)</option>
    <option value="126" selected>Grande - 20-22cm (~126g de pulpa)</option>
    <option value="152">Extra grande - más de 22cm (~152g de pulpa)</option>
  </select>
</div>

<div id="pl-wrap-unidades" style="display:none">
  <div class="row-2">
    <div>
      <label>Número de plátanos</label>
      <input type="number" id="pl-unidades" placeholder="2" value="1" min="1" oninput="calcPl()">
    </div>
    <div>
      <label>Tamaño</label>
      <select id="pl-tamano-uni" onchange="calcPl()">
        <option value="81">Pequeño (~81g)</option>
        <option value="105">Mediano (~105g)</option>
        <option value="126" selected>Grande (~126g)</option>
        <option value="152">Extra grande (~152g)</option>
      </select>
    </div>
  </div>
</div>

<label>Grado de madurez</label>
<select id="pl-madurez" onchange="calcPl()">
  <option value="0.97">Verde - poco maduro (menos azúcar, más almidón)</option>
  <option value="1.00" selected>Maduro - punto óptimo</option>
  <option value="1.05">Muy maduro - manchado (más dulce, más azúcar)</option>
</select>

<div class="result-box" id="pl-res">Introduce los gramos o selecciona el tamaño</div>

<div id="pl-nutri" style="display:none;margin-top:1rem">
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem" id="pl-cards"></div>
</div>

<div style="margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid var(--border)">
  <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem">Calorías del plátano según tamaño</h2>
  <table style="width:100%;font-size:0.825rem;border-collapse:collapse">
    <tr style="background:var(--accent-light)">
      <th style="padding:0.6rem 0.75rem;text-align:left;border-bottom:2px solid var(--accent);color:var(--accent)">Tamaño</th>
      <th style="padding:0.6rem 0.75rem;text-align:center;border-bottom:2px solid var(--accent);color:var(--accent)">Pulpa aprox.</th>
      <th style="padding:0.6rem 0.75rem;text-align:right;border-bottom:2px solid var(--accent);color:var(--accent)">Calorías</th>
    </tr>
    <tr><td style="padding:0.5rem 0.75rem">Pequeño (menos de 18cm)</td><td style="text-align:center">~81g</td><td style="text-align:right"><strong>72 kcal</strong></td></tr>
    <tr style="background:var(--bg)"><td style="padding:0.5rem 0.75rem">Mediano (18-20cm)</td><td style="text-align:center">~105g</td><td style="text-align:right"><strong>93 kcal</strong></td></tr>
    <tr><td style="padding:0.5rem 0.75rem">Grande (20-22cm)</td><td style="text-align:center">~126g</td><td style="text-align:right"><strong>112 kcal</strong></td></tr>
    <tr style="background:var(--bg)"><td style="padding:0.5rem 0.75rem">Extra grande (más de 22cm)</td><td style="text-align:center">~152g</td><td style="text-align:right"><strong>135 kcal</strong></td></tr>
    <tr><td style="padding:0.5rem 0.75rem">Plátano canario (pequeño)</td><td style="text-align:center">~70g</td><td style="text-align:right"><strong>62 kcal</strong></td></tr>
    <tr style="background:var(--bg)"><td style="padding:0.5rem 0.75rem">½ plátano grande</td><td style="text-align:center">~63g</td><td style="text-align:right"><strong>56 kcal</strong></td></tr>
