</div>

<div style="margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid var(--border)">
  <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem">Valor nutricional del plátano por 100g</h2>
  <table style="width:100%;font-size:0.825rem;border-collapse:collapse">
    <tr style="background:var(--accent-light)">
      <th style="padding:0.6rem 0.75rem;text-align:left;border-bottom:2px solid var(--accent);color:var(--accent)">Nutriente</th>
      <th style="padding:0.6rem 0.75rem;text-align:right;border-bottom:2px solid var(--accent);color:var(--accent)">Por 100g</th>
      <th style="padding:0.6rem 0.75rem;text-align:right;border-bottom:2px solid var(--accent);color:var(--accent)">Plátano grande (126g)</th>
    </tr>
    <tr><td style="padding:0.5rem 0.75rem">Calorías</td><td style="text-align:right">89 kcal</td><td style="text-align:right">112 kcal</td></tr>
    <tr style="background:var(--bg)"><td style="padding:0.5rem 0.75rem">Carbohidratos</td><td style="text-align:right">22,8g</td><td style="text-align:right">28,7g</td></tr>
    <tr><td style="padding:0.5rem 0.75rem">- Azúcares</td><td style="text-align:right">12,2g</td><td style="text-align:right">15,4g</td></tr>
    <tr style="background:var(--bg)"><td style="padding:0.5rem 0.75rem">- Fibra</td><td style="text-align:right">2,6g</td><td style="text-align:right">3,3g</td></tr>
    <tr><td style="padding:0.5rem 0.75rem">Proteínas</td><td style="text-align:right">1,1g</td><td style="text-align:right">1,4g</td></tr>
    <tr style="background:var(--bg)"><td style="padding:0.5rem 0.75rem">Grasas</td><td style="text-align:right">0,3g</td><td style="text-align:right">0,4g</td></tr>
    <tr><td style="padding:0.5rem 0.75rem">Potasio</td><td style="text-align:right">358 mg</td><td style="text-align:right">451 mg</td></tr>
