<script>
function toggleModoMz() {
  const modo = document.getElementById('mz-modo').value;
  document.getElementById('mz-wrap-gramos').style.display = modo === 'gramos' ? 'block' : 'none';
  document.getElementById('mz-wrap-tamano').style.display = modo === 'tamano' ? 'block' : 'none';
  calcMz();
}

function calcMz() {
  const variedad = document.getElementById('mz-variedad').value.split(',');
  const modo     = document.getElementById('mz-modo').value;
  const piel     = parseFloat(document.getElementById('mz-piel').value);
  let g = 0;

  if (modo === 'gramos') {
    g = parseFloat(document.getElementById('mz-gramos').value);
  } else {
    g = parseFloat(document.getElementById('mz-tamano').value);
  }

  if (!g || g <= 0) return;

  const kcal100 = parseFloat(variedad[0]) * piel;
  const gras100 = parseFloat(variedad[1]);
  const carb100 = parseFloat(variedad[2]);
  const azuc100 = parseFloat(variedad[3]);
  const fibr100 = parseFloat(variedad[4]);
  const prot100 = parseFloat(variedad[5]);

  const kcal = Math.round(kcal100 * g / 100);
  const carb = (carb100 * g / 100).toFixed(1);
  const azuc = (azuc100 * g / 100).toFixed(1);
  const fibr = (fibr100 * g / 100).toFixed(1);
  const prot = (prot100 * g / 100).toFixed(1);
  const gras = (gras100 * g / 100).toFixed(1);
  const pielLabel = piel === 1.0 ? 'con piel' : 'sin piel';

  document.getElementById('mz-res').innerHTML =
    `${kcal} kcal — ${g}g de manzana ${pielLabel}
    <small>Carbohidratos: ${carb}g · Azúcares: ${azuc}g · Fibra: ${fibr}g · Proteínas: ${prot}g</small>`;

  document.getElementById('mz-nutri').style.display = 'block';
  document.getElementById('mz-cards').innerHTML = `
    <div style="background:var(--accent-light);border:2px solid var(--accent);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--accent);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Calorías</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${kcal}</div>
      <div style="font-size:0.78rem;color:var(--accent)">kcal</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Carbohidratos</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${carb}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">de los cuales ${azuc}g azúcares</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Fibra</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${fibr}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">por ${g}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Proteínas</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${prot}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">por ${g}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Grasas</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${gras}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">por ${g}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Densidad calórica</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">Baja</div>
      <div style="font-size:0.78rem;color:var(--muted)">52 kcal/100g</div>
    </div>`;
}

calcMz();
</script>