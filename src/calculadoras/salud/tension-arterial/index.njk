<script>
function calcTA() {
  const sis = parseFloat(document.getElementById('ta-sis').value);
  const dia = parseFloat(document.getElementById('ta-dia').value);
  
  if (!sis || !dia) {
    document.getElementById('ta-res').innerHTML = 'Introduce tus valores de tensión';
    document.getElementById('pam-res').innerHTML = 'Presión Arterial Media (PAM): --';
    return;
  }

  // 1. Clasificación Tensión Arterial
  let cat, color, consejo;
  if (sis < 90 || dia < 60) {
    cat = 'Tensión baja (hipotensión)'; color = '#3B82F6';
    consejo = 'Consulta con tu médico si tienes síntomas como mareos o fatiga.';
  } else if (sis < 120 && dia < 80) {
    cat = 'Óptima ✓'; color = '#22C55E';
    consejo = 'Tu tensión es excelente. Mantén hábitos saludables.';
  } else if (sis < 130 && dia < 85) {
    cat = 'Normal ✓'; color = '#22C55E';
    consejo = 'Tu tensión está dentro de la normalidad.';
  } else if (sis < 140 && dia < 90) {
    cat = 'Normal-alta'; color = '#EAB308';
    consejo = 'Vigila tu tensión periódicamente y cuida la dieta y el ejercicio.';
  } else if (sis < 160 && dia < 100) {
    cat = 'Hipertensión grado 1'; color = '#EF4444';
    consejo = 'Consulta con tu médico. Cambios en el estilo de vida son importantes.';
  } else if (sis < 180 && dia < 110) {
    cat = 'Hipertensión grado 2'; color = '#DC2626';
    consejo = 'Consulta con tu médico pronto para valorar tratamiento.';
  } else {
    cat = 'Hipertensión grado 3 — consulta urgente'; color = '#7C3AED';
    consejo = 'Busca atención médica. Valores muy elevados.';
  }

  document.getElementById('ta-res').innerHTML =
    `<span style="color:${color}">${sis}/${dia} mmHg — ${cat}</span>
    <small>${consejo}</small>`;

  // 2. Cálculo de la Presión Arterial Media (PAM)
  const pam = (dia + ((sis - dia) / 3)).toFixed(1);
  let pamEstado, pamColor;

  if (pam >= 70 && pam <= 105) {
    pamEstado = 'Normal (70 - 105 mmHg)';
    pamColor = '#22C55E';
  } else if (pam < 70) {
    pamEstado = 'Baja (< 70 mmHg)';
    pamColor = '#3B82F6';
  } else {
    pamEstado = 'Elevada (> 105 mmHg)';
    pamColor = '#EF4444';
  }

  document.getElementById('pam-res').innerHTML =
    `Presión Arterial Media (PAM): <strong style="color:${pamColor}">${pam} mmHg</strong> <small style="display:inline;margin-left:0.5rem;">(${pamEstado})</small>`;
}
</script>

<div style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border)">
          
          
          <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem">Guía clínica sobre el control de la presión arterial y hemodinámica</h2>
          <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">La <strong>presión arterial</strong> representa la fuerza que ejerce la sangre contra las paredes internas de las arterias a medida que el corazón la bombea por todo el organismo. Mantener estos niveles dentro de límites saludables es fundamental para prevenir accidentes cerebrovasculares (ACV), infartos de miocardio y fallos renales.</p>
          <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">Nuestra <strong>calculadora de tensión arterial y Presión Arterial Media (PAM)</strong> evalúa tus lecturas mediante la clasificación oficial actualizada de la Sociedad Europea de Hipertensión (ESH), permitiéndote categorizar tus mediciones en segundos.</p>
          <h3 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem">Importancia de la Presión Arterial Media (PAM) en la evaluación de la salud</h3>
          <p style="color:var(--muted);font-size:0.9rem;line-height:1.8">A diferencia de las cifras aisladas de sistólica o diastólica, la <strong>PAM</strong> determina la presión continua de perfusión a la que están sometidos los órganos vitales (como el cerebro, el corazón y los riñones):</p>
          <p style="color:var(--muted);font-size:0.9rem;line-height:1.8"><strong>Mínimo funcional:</strong> Se requiere una PAM superior a 60-65 mmHg para garantizar que los tejidos corporales reciban suficiente riego de oxígeno y nutrientes.</p>
          <p style="color:var(--muted);font-size:0.9rem;line-height:1.8"><strong>Rango clínico óptimo:</strong> Valores entre 70 y 105 mmHg indican un equilibrio cardiovascular adecuado.</p>
          <p style="color:var(--muted);font-size:0.9rem;line-height:1.8"><strong>Riesgo por sobrecarga:</strong> Una PAM persistentemente superior a 105 mmHg incrementa la resistencia vascular sistémica y el sobreesfuerzo del ventrículo izquierdo.</p>
</div>