function filtrarCategoria() {
  const cat = document.getElementById('cal-cat').value;
  const select = document.getElementById('cal-alim');
  select.innerHTML = '';

  const grupos = cat === 'todos'
    ? Object.values(ALIMENTOS).flat()
    : ALIMENTOS[cat] || [];

  const lista = cat === 'todos'
    ? grupos.sort((a,b) => a.nombre.localeCompare(b.nombre))
    : grupos;

  lista.forEach(a => {
    const opt = document.createElement('option');
    opt.value = a.kcal;
    opt.textContent = `${a.nombre} — ${a.kcal} kcal/100g`;
    select.appendChild(opt);
  });

  calcCalAlim();
}

function calcCalAlim() {
  const kcalPor100 = parseFloat(document.getElementById('cal-alim').value);
  const g = parseFloat(document.getElementById('cal-alim-g').value);
  const nombreCompleto = document.getElementById('cal-alim').options[document.getElementById('cal-alim').selectedIndex]?.text || '';
  const nombre = nombreCompleto.split(' — ')[0];
  if (!kcalPor100) return;
  if (!g) {
    document.getElementById('cal-alim-res').innerHTML = `${nombre}: ${kcalPor100} kcal/100g`;
    return;
  }
  const total = (kcalPor100 * g / 100);
  document.getElementById('cal-alim-res').innerHTML =
    `${total.toFixed(0)} kcal
    <small>${g}g de ${nombre} · ${kcalPor100} kcal por 100g</small>`;
}

// Inicializar con todos los alimentos al cargar
filtrarCategoria();
