<div style="margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid var(--border)">
  <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem">¿Qué método de cocción tiene menos calorías?</h2>
  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">Si buscas la opción con menos calorías, lo más sencillo es cocinar el huevo sin añadir aceite. Un huevo cocido, pasado por agua o pochado apenas cambia sus calorías respecto al huevo en sí. En cambio, al freírlo hay que tener en cuenta el aceite que se utiliza.</p>
  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">El revuelto también puede ser una opción bastante ligera si se prepara sin aceite o con muy poca cantidad. En este caso, las calorías dependerán sobre todo de lo que añadas al huevo durante la preparación.</p>
  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">Con el huevo frito ocurre algo diferente. El aceite aporta calorías adicionales y una parte puede quedarse en el huevo. Por eso dos huevos del mismo tamaño pueden tener un número de calorías bastante distinto dependiendo de cómo se hayan cocinado.</p>

  <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem;margin-top:1.25rem">Clara vs yema - ¿cuál elegir?</h2>
  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">La clara es la parte más ligera del huevo. Tiene unas 17 calorías en un huevo mediano y aporta alrededor de 3,6 g de proteína. Por eso es habitual verla en recetas o dietas en las que se busca aumentar la proteína sin añadir demasiadas calorías.</p>
  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">La yema tiene más calorías, unas 55 en un huevo mediano, pero también es donde se encuentran buena parte de las vitaminas, minerales y grasas del huevo. Quitarla reduce las calorías, aunque también estás dejando fuera una parte importante de sus nutrientes.</p>
  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8">Por eso, salvo que tengas un motivo concreto para separar las dos partes, comer el huevo entero es una opción sencilla para aprovechar tanto la proteína de la clara como los nutrientes de la yema.</p>
</div>

<script>
const HV_BASE = {
  S:  { peso: 43, kcal: 62,  prot: 5.3, grasas: 4.2, carbs: 0.4, clara_kcal: 13, yema_kcal: 42 },
  M:  { peso: 53, kcal: 77,  prot: 6.5, grasas: 5.3, carbs: 0.6, clara_kcal: 17, yema_kcal: 55 },
  L:  { peso: 63, kcal: 91,  prot: 7.7, grasas: 6.2, carbs: 0.7, clara_kcal: 20, yema_kcal: 65 },
  XL: { peso: 73, kcal: 106, prot: 9.0, grasas: 7.3, carbs: 0.8, clara_kcal: 24, yema_kcal: 76 }
};

const HV_COCCION = {
  cocido:      { factor: 1.00, extra: 0,  label: 'Cocido / Duro' },
  pasado:      { factor: 1.00, extra: 0,  label: 'Pasado por agua' },
  revuelto:    { factor: 1.00, extra: 9,  label: 'Revuelto sin aceite' },
  frito_poco:  { factor: 1.00, extra: 35, label: 'Frito con poco aceite' },
  frito_normal:{ factor: 1.00, extra: 60, label: 'Frito con aceite normal' },
  pochado:     { factor: 1.00, extra: 2,  label: 'Pochado / Escalfado' },
  crudo:       { factor: 1.00, extra: 0,  label: 'Crudo' }
};

const HV_TAMANO_KEY = { '43': 'S', '53': 'M', '63': 'L', '73': 'XL' };

function calcHv() {
  const tamanoVal = document.getElementById('hv-tamano').value;
  const coccion   = document.getElementById('hv-coccion').value;
  const cantidad  = parseInt(document.getElementById('hv-cantidad').value) || 1;
  const key       = HV_TAMANO_KEY[tamanoVal];
  const base      = HV_BASE[key];
  const coc       = HV_COCCION[coccion];

  if (!base || !coc) return;

  const kcalUno   = Math.round(base.kcal * coc.factor + coc.extra);
  const kcalTotal = kcalUno * cantidad;
  const protTotal = (base.prot * cantidad).toFixed(1);
  const grasTotal = (base.grasas * cantidad).toFixed(1);
  const carbTotal = (base.carbs * cantidad).toFixed(1);
  const huevosStr = cantidad === 1 ? '1 huevo' : `${cantidad} huevos`;

  document.getElementById('hv-res').innerHTML =
    `${kcalTotal} kcal - ${huevosStr} ${key} ${coc.label}
    <small>Proteínas: ${protTotal}g · Grasas: ${grasTotal}g · Carbohidratos: ${carbTotal}g</small>`;

  document.getElementById('hv-nutri').style.display = 'block';
  document.getElementById('hv-cards').innerHTML = `
    <div style="background:var(--accent-light);border:2px solid var(--accent);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--accent);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Calorías</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${kcalTotal}</div>
      <div style="font-size:0.78rem;color:var(--accent)">${kcalUno} kcal/huevo</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Proteínas</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${protTotal}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">${base.prot}g/huevo</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Grasas</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${grasTotal}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">${base.grasas}g/huevo</div>
    </div>`;

  document.getElementById('hv-partes-wrap').style.display = 'block';
  document.getElementById('hv-partes').innerHTML = `
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Solo la clara</div>
      <div style="font-size:1.4rem;font-weight:700;color:var(--accent)">${base.clara_kcal * cantidad} kcal</div>
      <div style="font-size:0.78rem;color:var(--muted)">~${(base.prot * 0.55 * cantidad).toFixed(1)}g proteína</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Solo la yema</div>
      <div style="font-size:1.4rem;font-weight:700;color:var(--accent)">${base.yema_kcal * cantidad} kcal</div>
      <div style="font-size:0.78rem;color:var(--muted)">~${(base.prot * 0.42 * cantidad).toFixed(1)}g proteína</div>
    </div>`;
}

calcHv();
</script>