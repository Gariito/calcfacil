<script>
function calcPesoIdeal() {
  const h = parseFloat(document.getElementById('pi-altura').value);
  const edad = parseFloat(document.getElementById('pi-edad').value);
  const sexo = document.getElementById('pi-sexo').value;
  if (!h || !edad) return;

  const hm = h / 100;
  const hpulgadas = (h - 152.4) / 2.54;

  // Fórmulas base
  let lorentz = sexo==='h' ? h - 100 - (h-150)/4 : h - 100 - (h-150)/2;
  let devine   = sexo==='h' ? 50 + 2.3 * hpulgadas : 45.5 + 2.3 * hpulgadas;
  let hamwi    = sexo==='h' ? 48 + 2.7 * hpulgadas : 45.4 + 2.2 * hpulgadas;

  // Ajuste por edad — a partir de 25 años se permite +0.5kg por año hasta máximo +10kg
  const ajusteEdad = edad > 25 ? Math.min((edad - 25) * 0.5, 10) : 0;
  lorentz += ajusteEdad;
  devine  += ajusteEdad;
  hamwi   += ajusteEdad;

  // Rango IMC saludable
  const imcMin = (18.5 * hm * hm).toFixed(1);
  const imcMax = (24.9 * hm * hm).toFixed(1);

  // Media de las tres fórmulas
  const media = ((lorentz + devine + hamwi) / 3).toFixed(1);

  document.getElementById('pi-res').innerHTML =
    `Peso ideal estimado: ${media} kg
    <small>
    Rango saludable por IMC: ${imcMin} – ${imcMax} kg · 
    Ajuste por edad: +${ajusteEdad.toFixed(1)} kg
    </small>`;

  document.getElementById('pi-tabla').innerHTML = `
