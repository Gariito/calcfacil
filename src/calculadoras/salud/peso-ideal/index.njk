      <div style="font-size:1.2rem;font-weight:700;color:var(--accent)">${lorentz.toFixed(1)} kg</div>
      <div style="font-size:0.78rem;color:var(--muted);margin-top:0.25rem">Lorentz</div>
      <div style="font-size:0.72rem;color:var(--muted)">Más usada en Europa</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.2rem;font-weight:700;color:var(--accent)">${devine.toFixed(1)} kg</div>
      <div style="font-size:0.78rem;color:var(--muted);margin-top:0.25rem">Devine</div>
      <div style="font-size:0.72rem;color:var(--muted)">Usada en farmacología</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.2rem;font-weight:700;color:var(--accent)">${hamwi.toFixed(1)} kg</div>
      <div style="font-size:0.78rem;color:var(--muted);margin-top:0.25rem">Hamwi</div>
      <div style="font-size:0.72rem;color:var(--muted)">Usada en dietética</div>
    </div>`;
}
</script>

