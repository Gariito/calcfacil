  <p style="color:var(--muted);font-size:0.78rem;margin-top:0.5rem">* Valores medios de referencia para aguacate Hass, la variedad más consumida en España. Pueden variar según la variedad y el grado de madurez.</p>
</div>

<div style="margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid var(--border)">
  <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem">¿Por qué el aguacate tiene tantas calorías?</h2>
  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">El aguacate tiene más calorías que la mayoría de frutas porque contiene bastante grasa. Aproximadamente un 15% de su peso corresponde a grasa, y cada gramo de grasa aporta unas 9 calorías. Por eso, aunque sea una fruta, tiene una densidad calórica bastante alta.</p>
  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">Gran parte de esta grasa es ácido oleico, una grasa monoinsaturada que también encontramos en alimentos como el aceite de oliva. Además, el aguacate aporta fibra, vitaminas y minerales, por lo que sus calorías vienen acompañadas de otros nutrientes.</p>

  <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem;margin-top:1.25rem">¿Cuánto aguacate es recomendable comer?</h2>
  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">No hay una cantidad que sirva para todo el mundo. Como referencia, medio aguacate suele ser una porción bastante habitual y aporta aproximadamente entre 120 y 160 calorías, dependiendo de su peso.</p>
  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">Si estás intentando perder peso, también puedes comer aguacate. Simplemente conviene tener en cuenta sus calorías y la cantidad que añades a las comidas, especialmente si además utilizas otros alimentos ricos en grasa.</p>

  <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem;margin-top:1.25rem">Comparativa calórica del aguacate con otras frutas</h2>
  <table style="width:100%;font-size:0.825rem;border-collapse:collapse">
    <tr style="background:var(--accent-light)">
      <th style="padding:0.6rem 0.75rem;text-align:left;border-bottom:2px solid var(--accent);color:var(--accent)">Fruta</th>
      <th style="padding:0.6rem 0.75rem;text-align:right;border-bottom:2px solid var(--accent);color:var(--accent)">Calorías por 100g</th>
    </tr>
    <tr><td style="padding:0.5rem 0.75rem">🥑 Aguacate</td><td style="text-align:right"><strong>160 kcal</strong></td></tr>
    <tr style="background:var(--bg)"><td style="padding:0.5rem 0.75rem">🍌 Plátano</td><td style="text-align:right">89 kcal</td></tr>
    <tr><td style="padding:0.5rem 0.75rem">🍇 Uva</td><td style="text-align:right">67 kcal</td></tr>
    <tr style="background:var(--bg)"><td style="padding:0.5rem 0.75rem">🍎 Manzana</td><td style="text-align:right">52 kcal</td></tr>
    <tr><td style="padding:0.5rem 0.75rem">🍊 Naranja</td><td style="text-align:right">47 kcal</td></tr>
    <tr style="background:var(--bg)"><td style="padding:0.5rem 0.75rem">🍓 Fresa</td><td style="text-align:right">32 kcal</td></tr>
    <tr><td style="padding:0.5rem 0.75rem">🍉 Sandía</td><td style="text-align:right">30 kcal</td></tr>
  </table>
</div>

<script>
const AG_KCAL = 160;
const AG_GRASAS = 14.7;
const AG_CARBS = 8.5;
const AG_PROT = 2.0;
const AG_FIBRA = 6.7;

function toggleModo() {
  const modo = document.getElementById('ag-modo').value;
  document.getElementById('ag-wrap-gramos').style.display  = modo === 'gramos'  ? 'block' : 'none';
  document.getElementById('ag-wrap-tamano').style.display  = modo === 'tamano'  ? 'block' : 'none';
  document.getElementById('ag-wrap-porcion').style.display = modo === 'porcion' ? 'block' : 'none';
  calcAg();
}

function calcAg() {
  const modo = document.getElementById('ag-modo').value;
  let g = 0;

  if (modo === 'gramos') {
    g = parseFloat(document.getElementById('ag-gramos').value);
  } else if (modo === 'tamano') {
    g = parseFloat(document.getElementById('ag-tamano').value);
  } else {
    g = parseFloat(document.getElementById('ag-porcion').value);
  }

  if (!g || g <= 0) return;

  const kcal   = (AG_KCAL   * g / 100).toFixed(0);
  const grasas = (AG_GRASAS * g / 100).toFixed(1);
  const carbs  = (AG_CARBS  * g / 100).toFixed(1);
  const prot   = (AG_PROT   * g / 100).toFixed(1);
  const fibra  = (AG_FIBRA  * g / 100).toFixed(1);

  document.getElementById('ag-res').innerHTML =
    `${kcal} kcal por ${g}g de aguacate
    <small>Grasas: ${grasas}g · Carbohidratos: ${carbs}g · Proteínas: ${prot}g · Fibra: ${fibra}g</small>`;

  document.getElementById('ag-nutri').style.display = 'block';
  document.getElementById('ag-cards').innerHTML = `
    <div style="background:var(--accent-light);border:2px solid var(--accent);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--accent);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Calorías</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${kcal}</div>
      <div style="font-size:0.78rem;color:var(--accent)">kcal</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Grasas</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${grasas}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">de las cuales ${(2.1*g/100).toFixed(1)}g saturadas</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Carbohidratos</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${carbs}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">de los cuales ${fibra}g fibra</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Proteínas</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${prot}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">por ${g}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Fibra</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${fibra}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">por ${g}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Densidad calórica</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">Alta</div>
      <div style="font-size:0.78rem;color:var(--muted)">160 kcal/100g</div>
    </div>`;
}
</script>