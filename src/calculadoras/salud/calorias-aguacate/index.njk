    <tr><td style="padding:0.5rem 0.75rem">½ aguacate mediano</td><td style="text-align:right">~100g</td><td style="text-align:right"><strong>160 kcal</strong></td></tr>
    <tr style="background:var(--bg)"><td style="padding:0.5rem 0.75rem">Aguacate pequeño entero</td><td style="text-align:right">~100g</td><td style="text-align:right"><strong>160 kcal</strong></td></tr>
    <tr><td style="padding:0.5rem 0.75rem">Aguacate mediano entero</td><td style="text-align:right">~150g</td><td style="text-align:right"><strong>240 kcal</strong></td></tr>
    <tr style="background:var(--bg)"><td style="padding:0.5rem 0.75rem">Aguacate grande entero</td><td style="text-align:right">~200g</td><td style="text-align:right"><strong>320 kcal</strong></td></tr>
