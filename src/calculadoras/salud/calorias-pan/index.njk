<script>
function toggleModoPan() {
  const modo = document.getElementById('pan-modo').value;
  document.getElementById('pan-wrap-gramos').style.display    = modo === 'gramos'    ? 'block' : 'none';
  document.getElementById('pan-wrap-rebanadas').style.display = modo === 'rebanadas' ? 'block' : 'none';
  document.getElementById('pan-wrap-unidad').style.display    = modo === 'unidad'    ? 'block' : 'none';
  calcPan();
}

function setPanRapido(g, modo) {
  document.getElementById('pan-modo').value = modo;
  toggleModoPan();
  if (modo === 'gramos') {
    document.getElementById('pan-gramos').value = g;
  } else if (modo === 'rebanadas') {
    document.getElementById('pan-rebanadas').value = 1;
    document.getElementById('pan-grosor').value = g;
  }
  calcPan();
}

function calcPan() {
  const tipoVal = document.getElementById('pan-tipo').value.split(',');
  const modo    = document.getElementById('pan-modo').value;
  let g = 0;

  if (modo === 'gramos') {
    g = parseFloat(document.getElementById('pan-gramos').value);
  } else if (modo === 'rebanadas') {
    const num    = parseInt(document.getElementById('pan-rebanadas').value) || 1;
    const grosor = parseFloat(document.getElementById('pan-grosor').value);
    g = num * grosor;
  } else {
    g = parseFloat(document.getElementById('pan-unidad').value);
  }

  if (!g || g <= 0) return;

  const kcal100 = parseFloat(tipoVal[0]);
  const prot100 = parseFloat(tipoVal[1]);
  const carb100 = parseFloat(tipoVal[2]);
  const gras100 = parseFloat(tipoVal[3]);
  const fibr100 = parseFloat(tipoVal[4]);
  const sal100  = parseFloat(tipoVal[5]);

  const kcal = Math.round(kcal100 * g / 100);
  const prot = (prot100 * g / 100).toFixed(1);
  const carb = (carb100 * g / 100).toFixed(1);
  const gras = (gras100 * g / 100).toFixed(1);
  const fibr = (fibr100 * g / 100).toFixed(1);
  const sal  = (sal100  * g / 100).toFixed(1);

  const tipoNombre = document.getElementById('pan-tipo').options[document.getElementById('pan-tipo').selectedIndex].text;

  document.getElementById('pan-res').innerHTML =
    `${kcal} kcal — ${g}g de ${tipoNombre}
    <small>Carbohidratos: ${carb}g · Proteínas: ${prot}g · Grasas: ${gras}g · Fibra: ${fibr}g · Sal: ${sal}g</small>`;

  document.getElementById('pan-nutri').style.display = 'block';
  document.getElementById('pan-cards').innerHTML = `
    <div style="background:var(--accent-light);border:2px solid var(--accent);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--accent);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Calorías</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${kcal}</div>
      <div style="font-size:0.78rem;color:var(--accent)">kcal</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Carbohidratos</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${carb}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">por ${g}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Proteínas</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${prot}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">por ${g}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Grasas</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${gras}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">por ${g}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Fibra</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${fibr}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">por ${g}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Sal</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${sal}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">por ${g}g</div>
    </div>`;
}

calcPan();
</script>