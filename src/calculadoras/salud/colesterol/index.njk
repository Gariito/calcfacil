<script>
function evalCol(val, limites) {
  for (const [max, label, color] of limites) {
    if (val < max) return { label, color };
  }
  return limites[limites.length - 1];
}
function calcCol() {
  const total = parseFloat(document.getElementById('col-total').value);
  const ldl = parseFloat(document.getElementById('col-ldl').value);
  const hdl = parseFloat(document.getElementById('col-hdl').value);
  const trig = parseFloat(document.getElementById('col-trig').value);

  let lines = [];

  if (!isNaN(total)) {
    const r = total < 200 ? ['Deseable ✓','#22C55E'] : total < 240 ? ['Límite alto','#EAB308'] : ['Alto','#EF4444'];
    lines.push(`Total: <span style="color:${r[1]}">${total} mg/dL — ${r[0]}</span>`);
  }
  if (!isNaN(ldl)) {
    const r = ldl < 100 ? ['Óptimo ✓','#22C55E'] : ldl < 130 ? ['Deseable','#22C55E'] : ldl < 160 ? ['Límite alto','#EAB308'] : ['Alto','#EF4444'];
    lines.push(`LDL: <span style="color:${r[1]}">${ldl} mg/dL — ${r[0]}</span>`);
  }
  if (!isNaN(hdl)) {
    const r = hdl < 40 ? ['Bajo — riesgo','#EF4444'] : hdl < 60 ? ['Normal','#22C55E'] : ['Alto — protector ✓','#22C55E'];
    lines.push(`HDL: <span style="color:${r[1]}">${hdl} mg/dL — ${r[0]}</span>`);
  }
  if (!isNaN(trig)) {
    const r = trig < 150 ? ['Normal ✓','#22C55E'] : trig < 200 ? ['Límite alto','#EAB308'] : trig < 500 ? ['Alto','#EF4444'] : ['Muy alto','#7C3AED'];
    lines.push(`Triglicéridos: <span style="color:${r[1]}">${trig} mg/dL — ${r[0]}</span>`);
  }

  if (lines.length === 0) return;
  document.getElementById('col-res').innerHTML = lines.join('<br>');
}
</script>

<div style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border)">
          
          
          <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem">Interpretación del perfil lipídico más allá de los números</h2>
          <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">Tener el colesterol alto no genera dolor ni da avisos claros en el día a día. Por eso se le presta tanta atención en las revisiones rutinarias. El colesterol es una sustancia cérea que el hígado fabrica de forma natural y que resulta imprescindible para producir hormonas, vitamina D y recubrir las membranas celulares. Sin embargo, cuando circula en exceso por el torrente sanguíneo, el sobrante se acumula progresivamente en las paredes de los vasos.</p>
          <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">A la hora de interpretar una analítica, no basta con mirar una sola cifra aislada. Los médicos valoran el equilibrio global entre los distintos componentes del perfil lipídico.</p>
          <h3 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem">Los tres marcadores clave y los índices de riesgo</h3>
          <p style="color:var(--muted);font-size:0.9rem;line-height:1.8"><strong>Colesterol LDL (lipoproteínas de baja densidad):</strong> Es el encargado de repartir el colesterol desde el hígado hacia el resto del cuerpo. Si hay demasiada cantidad, se oxida y se adhiere al endotelio arterial, dando lugar a la placa de ateroma.</p>
          <p style="color:var(--muted);font-size:0.9rem;line-height:1.8"><strong>Colesterol HDL (lipoproteínas de alta densidad):</strong> Realiza la función inversa. Recoge el exceso de grasa depositado en los tejidos y los vasos y lo transporta de vuelta al hígado para su descomposición. Por eso, tener un HDL elevado es un factor de protección.</p>
          <p style="color:var(--muted);font-size:0.9rem;line-height:1.8"><strong>Relación Colesterol Total / HDL (Índice de Castelli):</strong> Un indicador muy utilizado en clínica. Lo ideal es que este cociente sea inferior a 4,5. Cuanto más bajo sea el resultado, menor será la proporción de grasas circulantes con potencial patológico.</p>
