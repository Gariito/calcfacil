<div style="margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid var(--border)">
  <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem">Arroz crudo vs cocido — cómo afecta al peso y las calorías</h2>
  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">El error más habitual al calcular las calorías del arroz es confundir los valores en crudo y en cocido. El etiquetado nutricional de los paquetes de arroz siempre indica los valores en crudo, pero nosotros generalmente lo pesamos después de cocinarlo.</p>
  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">Durante la cocción el arroz absorbe agua y multiplica su peso aproximadamente por 3. Esto significa que <strong>100g de arroz crudo (360 kcal) se convierten en unos 300g de arroz cocido (360 kcal)</strong>. Las calorías totales son las mismas — solo cambia el peso.</p>
  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">Para contar calorías con precisión lo más recomendable es pesar el arroz en crudo antes de cocinarlo, ya que la cantidad de agua absorbida puede variar según el tiempo de cocción y la cantidad de agua utilizada.</p>
</div>

<script>
function setArRacion(g) {
  document.getElementById('ar-gramos').value = g;
  calcAr();
}

function calcAr() {
  const tipoVal = document.getElementById('ar-tipo').value;
  const g       = parseFloat(document.getElementById('ar-gramos').value);
  if (!g || g <= 0) return;

  const partes  = tipoVal.split(',');
  const nombre  = partes[0].replace('_', ' ');
  const kcal100 = parseFloat(partes[1]);
  const prot100 = parseFloat(partes[2]);
  const carb100 = parseFloat(partes[3]);
  const fibr100 = parseFloat(partes[4]);
  const gras100 = parseFloat(partes[5]);

  const kcal = Math.round(kcal100 * g / 100);
  const prot = (prot100 * g / 100).toFixed(1);
  const carb = (carb100 * g / 100).toFixed(1);
  const fibr = (fibr100 * g / 100).toFixed(1);
  const gras = (gras100 * g / 100).toFixed(1);

  document.getElementById('ar-res').innerHTML =
    `${kcal} kcal — ${g}g de arroz ${nombre}
    <small>Carbohidratos: ${carb}g · Proteínas: ${prot}g · Grasas: ${gras}g · Fibra: ${fibr}g</small>`;

  document.getElementById('ar-nutri').style.display = 'block';
  document.getElementById('ar-cards').innerHTML = `
    <div style="background:var(--accent-light);border:2px solid var(--accent);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--accent);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Calorías</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${kcal}</div>
      <div style="font-size:0.78rem;color:var(--accent)">kcal</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Carbohidratos</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${carb}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">por ${g}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Proteínas</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${prot}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">por ${g}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Grasas</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${gras}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">por ${g}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Fibra</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${fibr}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">por ${g}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Por 100g</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${kcal100}</div>
      <div style="font-size:0.78rem;color:var(--muted)">kcal/100g</div>
    </div>`;
}

calcAr();
</script>