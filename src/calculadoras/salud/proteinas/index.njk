<script>
const PROT_FACTORES = {
  sedentario:  { min: 0.8,  max: 1.0 },
  ligero:      { min: 1.0,  max: 1.3 },
  moderado:    { min: 1.2,  max: 1.6 },
  activo:      { min: 1.6,  max: 2.0 },
  muy_activo:  { min: 1.8,  max: 2.2 },
  atletico:    { min: 2.0,  max: 2.4 }
};

const PROT_OBJETIVO = {
  adelgazar:      { ajuste: 0.3, label: 'Pérdida de grasa', color: '#EF4444', desc: 'Proteína alta para preservar músculo en déficit calórico.' },
  mantener:       { ajuste: 0,   label: 'Mantenimiento',    color: '#22C55E', desc: 'Proteína moderada para mantener composición corporal.' },
  musculo:        { ajuste: 0.2, label: 'Ganancia muscular', color: '#3B82F6', desc: 'Proteína alta junto a superávit calórico para maximizar la síntesis muscular.' },
  recomposicion:  { ajuste: 0.3, label: 'Recomposición',    color: '#8B5CF6', desc: 'Proteína muy alta para perder grasa y ganar músculo simultáneamente.' },
  rendimiento:    { ajuste: 0.4, label: 'Rendimiento',       color: '#F59E0B', desc: 'Proteína máxima para atletas de competición y deportes de resistencia.' }
};

const PROT_DIETA = {
  omnivora:    { ajuste: 0,    label: 'Omnívora' },
  vegetariana: { ajuste: 0.1,  label: 'Vegetariana (+10% por menor biodisponibilidad)' },
  vegana:      { ajuste: 0.15, label: 'Vegana (+15% por menor biodisponibilidad)' }
};

function calcProt() {
  const peso = parseFloat(document.getElementById('prot-peso').value);
  const actividad = document.getElementById('prot-actividad').value;
  const objetivo = document.getElementById('prot-objetivo').value;
  const dieta = document.getElementById('prot-dieta').value;
  const sexo = document.getElementById('prot-sexo').value;
  const edad = parseFloat(document.getElementById('prot-edad').value)||30;
  const altura = parseFloat(document.getElementById('prot-altura').value)||170;
  if (!peso) return;

  const factor = PROT_FACTORES[actividad];
  const obj = PROT_OBJETIVO[objetivo];
  const diet = PROT_DIETA[dieta];

  let minProt = (factor.min + obj.ajuste + diet.ajuste) * peso;
  let maxProt = (factor.max + obj.ajuste + diet.ajuste) * peso;
  const medio = Math.round((minProt + maxProt) / 2);
  minProt = Math.round(minProt);
  maxProt = Math.round(maxProt);

  // Calorías proteína
  const kcalMin = minProt * 4;
  const kcalMax = maxProt * 4;

  // TMB para % calorías
  const tmb = sexo==='h'
    ? 10*peso + 6.25*altura - 5*edad + 5
    : 10*peso + 6.25*altura - 5*edad - 161;
  const factoresTDEE = {sedentario:1.2,ligero:1.375,moderado:1.55,activo:1.725,muy_activo:1.9,atletico:1.9};
  const tdee = Math.round(tmb * factoresTDEE[actividad]);
  const pctMin = Math.round(kcalMin/tdee*100);
  const pctMax = Math.round(kcalMax/tdee*100);

  document.getElementById('prot-res').innerHTML =
    `${minProt}–${maxProt} g de proteína al día
    <small>${obj.label} · ${diet.label} · ${kcalMin}–${kcalMax} kcal de proteína · ${pctMin}-${pctMax}% de tus calorías</small>`;

  document.getElementById('prot-desglose').style.display = 'block';
  document.getElementById('prot-cards').innerHTML = `
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Mínimo</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${minProt}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">${(minProt/peso).toFixed(1)}g/kg</div>
    </div>
    <div style="background:var(--accent-light);border:2px solid var(--accent);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--accent);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Objetivo ideal</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${medio}g</div>
      <div style="font-size:0.78rem;color:var(--accent)">${(medio/peso).toFixed(1)}g/kg</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Máximo</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${maxProt}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">${(maxProt/peso).toFixed(1)}g/kg</div>
    </div>`;

  // Distribución por comidas
  document.getElementById('prot-fuentes-wrap').style.display = 'block';
  const comidas = [
    ['Desayuno', Math.round(medio*0.25)],
    ['Media mañana', Math.round(medio*0.15)],
    ['Comida', Math.round(medio*0.30)],
    ['Merienda', Math.round(medio*0.10)],
    ['Cena', Math.round(medio*0.20)]
  ];
  document.getElementById('prot-fuentes').innerHTML = `
    <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:1rem">${obj.desc} Para alcanzar <strong>${medio}g diarios</strong>, distribuye la proteína en 4-5 comidas:</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:0.5rem;margin-bottom:1rem">
      ${comidas.map(([c,g])=>`
        <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.65rem;text-align:center">
          <div style="font-size:0.75rem;color:var(--muted)">${c}</div>
          <div style="font-size:1.1rem;font-weight:700;color:var(--accent)">${g}g</div>
        </div>`).join('')}
    </div>
    <p style="color:var(--muted);font-size:0.85rem">💡 <strong>Truco:</strong> ${medio}g de proteína equivalen aproximadamente a ${Math.round(medio/31*100)}g de pechuga de pollo, ${Math.round(medio/29)} latas de atún, o ${Math.round(medio/10)} yogures griegos.</p>`;
}
</script>