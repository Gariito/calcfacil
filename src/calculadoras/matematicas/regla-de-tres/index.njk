<label>Tipo de proporción</label>
<select id="rt-tipo" onchange="calcRT()">
  <option value="directa">Directa — si A aumenta, B aumenta</option>
  <option value="inversa">Inversa — si A aumenta, B disminuye</option>
</select>

<div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:1.25rem;margin-bottom:1rem">
  <div class="row-2">
    <div>
      <label>Si A =</label>
      <input type="number" id="rt-a" placeholder="3" oninput="calcRT()">
    </div>

    <div>
      <label>entonces B =</label>
      <input type="number" id="rt-b" placeholder="7" oninput="calcRT()">
    </div>
  </div>

  <div class="row-2">
    <div>
      <label>Si A =</label>
      <input type="number" id="rt-c" placeholder="5" oninput="calcRT()">
    </div>

    <div>
      <label>entonces B =</label>
      <div class="result-box" id="rt-x" style="margin-top:0;font-size:1.3rem;min-height:44px">
        ?
      </div>
    </div>
  </div>
</div>

<div class="result-box" id="rt-res">
  Introduce los tres valores conocidos
</div>

<div style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border)">

  <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem">
    Ejemplos de regla de tres directa
  </h2>

  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">
    <strong>Combustible:</strong> Si un coche consume 6 litros para recorrer 100 km,
    ¿cuántos litros necesita para recorrer 250 km?
    → 100 km → 6 litros; 250 km → X.
    <strong>X = (6 × 250) / 100 = 15 litros.</strong>
  </p>

  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">
    <strong>Compras:</strong> Si 5 kg de manzanas cuestan 12 €, ¿cuánto cuestan 8 kg?
    → 5 kg → 12 €; 8 kg → X.
    <strong>X = (12 × 8) / 5 = 19,20 €.</strong>
  </p>

  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">
    <strong>Conversión de moneda:</strong> Si 10 dólares equivalen a 9 euros,
    ¿cuántos euros corresponden a 45 dólares?
    → 10 $ → 9 €; 45 $ → X.
    <strong>X = (9 × 45) / 10 = 40,50 €.</strong>
  </p>

  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">
    <strong>Impresión:</strong> Si una impresora tarda 2 minutos en imprimir 30 páginas,
    ¿cuántas páginas puede imprimir en 7 minutos?
    → 2 min → 30 páginas; 7 min → X.
    <strong>X = (30 × 7) / 2 = 105 páginas.</strong>
  </p>

  <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin:1.5rem 0 1rem">
    Ejemplos de regla de tres inversa
  </h2>

  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0.75rem">
    <strong>Velocidad y tiempo:</strong> Si un tren viaja a 90 km/h y tarda 4 horas
    en llegar a su destino, ¿cuánto tardará si aumenta su velocidad a 120 km/h?
    → 90 km/h → 4 horas; 120 km/h → X.
    <strong>X = (90 × 4) / 120 = 3 horas.</strong>
  </p>

  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8">
    <strong>Trabajadores:</strong> Si 3 trabajadores tardan 10 horas en realizar
    un trabajo, ¿cuánto tardarán 5 trabajadores trabajando al mismo ritmo?
    → 3 trabajadores → 10 horas; 5 trabajadores → X.
    <strong>X = (3 × 10) / 5 = 6 horas.</strong>
  </p>

</div>

<script>
function calcRT() {
  const a = parseFloat(document.getElementById('rt-a').value);
  const b = parseFloat(document.getElementById('rt-b').value);
  const c = parseFloat(document.getElementById('rt-c').value);
  const tipo = document.getElementById('rt-tipo').value;

  if (!a || !b || !c) return;

  const x = tipo === 'directa'
    ? (b * c) / a
    : (a * b) / c;

  const xFmt = parseFloat(x.toFixed(6)).toLocaleString('es-ES', {
    maximumFractionDigits: 4
  });

  document.getElementById('rt-x').textContent = xFmt;

  document.getElementById('rt-res').innerHTML =
    `X = ${xFmt}<small>Proporción ${tipo}: ${a} → ${b} · ${c} → ${xFmt}</small>`;
}
</script>