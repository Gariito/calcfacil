<script>
function calcCG() {
  const pesoInput = document.getElementById('cg-peso');
  const peso = parseFloat(pesoInput.value);
  const edad = document.getElementById('cg-edad').value;
  const estilo = document.getElementById('cg-estilo').value;
  const estado = document.getElementById('cg-estado').value;
  const tipo = document.getElementById('cg-tipo').value;
  const resultado = document.getElementById('cg-res');
  const aviso = document.getElementById('cg-aviso');
  const tarjetas = document.getElementById('cg-cards');

  // Ocultar resultados si no hay un peso válido.
  if (!pesoInput.value.trim() || !Number.isFinite(peso) || peso <= 0) {
    resultado.textContent = 'Introduce un peso válido para calcular la ración orientativa.';
    aviso.style.display = 'none';
    aviso.textContent = '';
    tarjetas.style.display = 'none';
    tarjetas.innerHTML = '';
    return;
  }

  // Estimación energética general: no equivale a una pauta veterinaria individual.
  const rer = 70 * Math.pow(peso, 0.75);

  const factoresBase = {
    cachorro: 2.5,
    adulto: 1.2,
    senior: 1.1
  };

  const factorEstilo = {
    interior: 0.9,
    mixto: 1.0,
    exterior: 1.2
  };

  const factorEstado = {
    esterilizado: 0.8,
    entero: 1.0,
    gestacion: 1.6
  };

  const factor = factoresBase[edad] * factorEstilo[estilo] * factorEstado[estado];
  const kcalDia = Math.round(rer * factor);

  let cantidad;
  let raciones;
  let detalle;

  if (tipo === 'seco') {
    cantidad = Math.round(kcalDia / 3.4);
    raciones = edad === 'cachorro' ? '3-4 tomas orientativas' : '2 tomas orientativas';
    detalle = `${cantidad} g de pienso seco al día`;
  } else if (tipo === 'humedo') {
    cantidad = Math.round(kcalDia / 0.8);
    raciones = '2-3 tomas orientativas';
    detalle = `${cantidad} g de comida húmeda al día`;
  } else {
    // Reparto aproximado del 50 % de las calorías de cada tipo de alimento.
    const gSeco = Math.round((kcalDia * 0.5) / 3.4);
    const gHumedo = Math.round((kcalDia * 0.5) / 0.8);
    detalle = `${gSeco} g de pienso + ${gHumedo} g de comida húmeda al día`;
    raciones = 'Repartir en varias tomas';
  }

  resultado.innerHTML = `
    <strong>${detalle}</strong>
    <small style="display:block;margin-top:0.45rem">
      Estimación: ${kcalDia} kcal al día · No es una pauta individual
    </small>
  `;

  aviso.textContent =
    'La cantidad real depende de las calorías indicadas en el envase, la condición corporal y las necesidades de tu gato. Comprueba la ración recomendada por el fabricante y consulta con un veterinario si necesita una dieta específica.';
  aviso.style.display = 'block';

  tarjetas.style.display = 'grid';
  tarjetas.innerHTML = tarjetasCG(kcalDia, tipo === 'mixta'
    ? detalle.replace(' al día', '')
    : `${cantidad} g`,
    raciones);
}

function tarjetasCG(kcal, cantidad, raciones) {
  return `
    <div style="background:var(--accent-light);border:2px solid var(--accent);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--accent);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Energía estimada</div>
      <div style="font-size:1.5rem;font-weight:700;color:var(--accent)">${kcal} kcal</div>
      <div style="font-size:0.75rem;color:var(--muted)">al día</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Cantidad estimada</div>
      <div style="font-size:1.05rem;font-weight:700;color:var(--accent)">${cantidad}</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Reparto</div>
      <div style="font-size:0.95rem;font-weight:700;color:var(--accent)">${raciones}</div>
    </div>`;
}
</script>