<script>
const EP_TABLA = {
  mini:    [0,15,24,28,32,36,40,44,48,52,56,60,64,68,72,76,80,83,86,89,91,93,95,96,97],
  pequeno: [0,15,24,28,32,36,41,47,52,57,60,63,66,69,72,75,78,80,82,84,86,88,89,90,91],
  mediano: [0,15,24,28,32,36,42,50,58,64,66,70,74,77,80,83,86,88,90,92,93,94,95,96,97],
  grande:  [0,15,24,28,32,38,45,52,58,64,69,73,77,82,86,89,91,93,95,96,97,98,99,100,101],
  gigante: [0,12,22,31,38,42,48,54,59,64,72,78,85,91,97,102,107,111,115,118,121,123,125,127,129]
};

function calcEP() {
  const edad   = parseInt(document.getElementById('ep-edad').value);
  const tamano = document.getElementById('ep-tamano').value;
  if (isNaN(edad) || edad < 0 || edad > 24) return;

  const tabla  = EP_TABLA[tamano];
  const humanos = tabla[Math.min(edad, tabla.length-1)];
  const tamanoLabel = {
    mini:'Mini/Toy (<10 kg)', pequeno:'Pequeño (10-20 kg)',
    mediano:'Mediano (20-30 kg)', grande:'Grande (30-45 kg)', gigante:'Gigante (>45 kg)'
  }[tamano];
  const etapa = edad <= 1 ? 'Cachorro' : humanos < 40 ? 'Adulto joven' : humanos < 60 ? 'Adulto maduro' : 'Senior';

  document.getElementById('ep-res').innerHTML =
    `${humanos} años humanos equivalentes
    <small>${edad} año${edad!==1?'s':''} de perro (${tamanoLabel}) · Etapa: ${etapa}</small>`;

  const el = document.getElementById('ep-cards');
  el.style.display = 'grid';
  el.innerHTML = `
    <div style="background:var(--accent-light);border:2px solid var(--accent);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--accent);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Años humanos estimados</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${humanos}</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Regla del 7</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--muted)">${edad*7}</div>
      <div style="font-size:0.75rem;color:var(--muted)">Cálculo simplificado</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Etapa vital estimada</div>
      <div style="font-size:1.1rem;font-weight:700;color:var(--accent)">${etapa}</div>
    </div>`;
}
</script>