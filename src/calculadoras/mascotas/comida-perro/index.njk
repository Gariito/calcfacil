<script>
function calcCP() {
  const peso      = parseFloat(document.getElementById('cp-peso').value);
  const edad      = document.getElementById('cp-edad').value;
  const actividad = document.getElementById('cp-actividad').value;
  const tipo      = document.getElementById('cp-tipo').value;
  const condicion = parseFloat(document.getElementById('cp-condicion').value);
  if (!peso || peso <= 0) return;

  // RER (Resting Energy Requirement)
  const rer = 70 * Math.pow(peso, 0.75);

  // Factores orientativos según edad y actividad.
  // Las necesidades reales pueden variar entre perros.
  const factores = {
    cachorro: { bajo: 2.5, normal: 3.0, alto: 3.5, trabajo: 4.0 },
    adulto:   { bajo: 1.4, normal: 1.6, alto: 2.0, trabajo: 2.5 },
    senior:   { bajo: 1.2, normal: 1.4, alto: 1.6, trabajo: 1.8 }
  };

  const factor = factores[edad][actividad] * condicion;
  const kcalDia = Math.round(rer * factor);

  // Conversión aproximada a gramos según la energía media del alimento.
  // Comprueba las kcal reales indicadas en el envase.
  let gDia, tipoLabel, raciones;
  if (tipo === 'seco') {
    gDia = Math.round(kcalDia / 3.5); // ~350 kcal/100 g
    tipoLabel = 'de pienso seco';
    raciones = edad === 'cachorro' ? '3-4 raciones' : '2 raciones';
  } else if (tipo === 'humedo') {
    gDia = Math.round(kcalDia / 0.9); // ~90 kcal/100 g
    tipoLabel = 'de comida húmeda';
    raciones = '2-3 raciones';
  } else if (tipo === 'mixta') {
    const gSeco  = Math.round((kcalDia * 0.6) / 3.5);
    const gHumedo = Math.round((kcalDia * 0.4) / 0.9);
    tipoLabel = 'mixta';
    raciones = '2 raciones';
    document.getElementById('cp-res').innerHTML =
      `${gSeco} g de pienso + ${gHumedo} g de comida húmeda al día
      <small>${kcalDia} kcal/día · 60% de las calorías del pienso + 40% de la comida húmeda · ${raciones}</small>`;
    mostrarCardsCP(kcalDia, gSeco, raciones, peso);
    return;
  } else {
    gDia = Math.round(kcalDia / 1.5); // ~150 kcal/100 g, solo como referencia
    tipoLabel = 'de dieta BARF / natural';
    raciones = '2 raciones';
  }

  document.getElementById('cp-res').innerHTML =
    `${gDia} g ${tipoLabel} al día
    <small>${kcalDia} kcal/día · ${raciones} · Factor aplicado: ${factor.toFixed(2)}</small>`;

  mostrarCardsCP(kcalDia, gDia, raciones, peso);
}

function mostrarCardsCP(kcal, gramos, raciones, peso) {
  document.getElementById('cp-desglose').style.display = 'block';
  document.getElementById('cp-cards').innerHTML = `
    <div style="background:var(--accent-light);border:2px solid var(--accent);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--accent);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Calorías diarias estimadas</div>
      <div style="font-size:1.5rem;font-weight:700;color:var(--accent)">${kcal} kcal</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Cantidad diaria estimada</div>
      <div style="font-size:1.5rem;font-weight:700;color:var(--accent)">${gramos} g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Raciones</div>
      <div style="font-size:1.1rem;font-weight:700;color:var(--accent)">${raciones}</div>
      <div style="font-size:0.78rem;color:var(--muted)">al día</div>
    </div>`;
}
</script>