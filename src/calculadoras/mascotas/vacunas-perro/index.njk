<script>
const VP_DATA = {
  '6s': {
    obligatorias: [
      { nombre: 'Moquillo (CDV)', desc: 'Enfermedad viral grave que afecta al sistema nervioso y respiratorio. Alta mortalidad en cachorros.' },
      { nombre: 'Hepatitis infecciosa (CAV)', desc: 'Afecta al hígado y puede causar insuficiencia hepática aguda.' },
      { nombre: 'Parvovirus (CPV)', desc: 'Causa gastroenteritis hemorrágica severa. Muy contagioso y mortal en cachorros.' }
    ],
    recomendadas: [],
    nota: 'Primera dosis de la vacuna polivalente (DHPPi). El cachorro ya puede iniciar la socialización en espacios controlados.'
  },
  '10s': {
    obligatorias: [
      { nombre: 'DHPPi — 2ª dosis', desc: 'Refuerzo de moquillo, hepatitis y parvovirus necesario para inmunización completa.' },
      { nombre: 'Leptospirosis (1ª dosis)', desc: 'Bacteria transmitida por roedores y agua contaminada. Puede contagiarse a humanos.' }
    ],
    recomendadas: [
      { nombre: 'Parainfluenza', desc: 'Componente de la tos de las perreras. Recomendada si el perro tiene contacto con otros perros.' }
    ],
    nota: 'Tras esta dosis el cachorro puede empezar a salir a la calle con precaución.'
  },
  '16s': {
    obligatorias: [
      { nombre: 'DHPPi — 3ª dosis', desc: 'Última dosis del protocolo inicial de cachorro. Inmunización completa.' },
      { nombre: 'Leptospirosis (2ª dosis)', desc: 'Segunda dosis necesaria para inmunización completa.' }
    ],
    recomendadas: [
      { nombre: 'Rabia', desc: 'Obligatoria en algunas CCAA. Recomendada para todos los perros.' },
      { nombre: 'Tos de las perreras (Bordetella)', desc: 'Recomendada si el perro va a residencias, parques caninos o tiene contacto frecuente con otros perros.' }
    ],
    nota: 'Tras completar las 3 dosis el cachorro tiene inmunidad completa. Ya puede salir con total seguridad.'
  },
  '6m': {
    obligatorias: [],
    recomendadas: [
      { nombre: 'Rabia', desc: 'Si no se administró a las 16 semanas. Obligatoria en algunas CCAA.' },
      { nombre: 'Tos de las perreras', desc: 'Recomendada si frecuenta parques o residencias caninas.' },
      { nombre: 'Leishmaniosis', desc: 'Recomendada en zonas de riesgo. Transmitida por la picadura del flebotomo.' }
    ],
    nota: 'Revisión veterinaria recomendada. Buen momento para esterilización si se desea.'
  },
  '1a': {
    obligatorias: [
      { nombre: 'Refuerzo DHPPi', desc: 'Primer refuerzo anual de la polivalente.' },
      { nombre: 'Refuerzo Leptospirosis', desc: 'Refuerzo anual necesario.' }
    ],
    recomendadas: [
      { nombre: 'Rabia (refuerzo)', desc: 'Cada 1-3 años según la vacuna utilizada.' },
      { nombre: 'Leishmaniosis (refuerzo)', desc: 'Refuerzo anual en zonas de riesgo.' }
    ],
    nota: 'Revisión completa del primer año. Análisis de sangre y revisión dental recomendados.'
  },
  adulto: {
    obligatorias: [
      { nombre: 'Refuerzo polivalente (DHPPi)', desc: 'Refuerzo anual o trienal según el protocolo y la vacuna.' },
      { nombre: 'Refuerzo Leptospirosis', desc: 'Refuerzo anual.' }
    ],
    recomendadas: [
      { nombre: 'Rabia', desc: 'Según la normativa de la comunidad autónoma.' },
      { nombre: 'Tos de las perreras', desc: 'Anual si frecuenta residencias o parques caninos.' },
      { nombre: 'Leishmaniosis', desc: 'Anual en zonas endémicas.' }
    ],
    nota: 'Además de las vacunas, desparasitación interna trimestral y externa mensual o trimestral según exposición.'
  }
};

function calcVP() {
  const edad     = document.getElementById('vp-edad').value;
  const ccaa     = document.getElementById('vp-ccaa').value;
  const exterior = document.getElementById('vp-exterior').value;
  const d        = VP_DATA[edad];

  let recomendadas = [...d.recomendadas];
  if (ccaa === 'rabia' && !d.obligatorias.find(v=>v.nombre.includes('Rabia'))) {
    const idx = recomendadas.findIndex(v=>v.nombre.includes('Rabia'));
    if (idx >= 0) {
      const rabia = recomendadas.splice(idx, 1)[0];
      d.obligatorias.push({...rabia, nombre: rabia.nombre + ' ⚠️ Obligatoria en tu CCAA'});
    }
  }
  if (exterior === 'no') {
    recomendadas = recomendadas.filter(v => !v.nombre.includes('Tos') && !v.nombre.includes('Leishmaniosis'));
  }

  const totalVacunas = d.obligatorias.length + recomendadas.length;
  document.getElementById('vp-res').innerHTML =
    `${totalVacunas} vacunas para esta etapa
    <small>${d.obligatorias.length} esenciales · ${recomendadas.length} recomendadas según situación · ${d.nota}</small>`;

  document.getElementById('vp-lista').style.display = 'block';
  let html = '';

  if (d.obligatorias.length > 0) {
    html += '<p style="font-size:0.8rem;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:0.5rem">Esenciales</p>';
    html += d.obligatorias.map(v => `
      <div style="background:#EFF6FF;border-left:3px solid var(--accent);border-radius:0 8px 8px 0;padding:0.75rem;margin-bottom:0.5rem">
        <strong style="font-size:0.875rem">${v.nombre}</strong>
        <p style="color:var(--muted);font-size:0.8rem;margin-top:0.2rem">${v.desc}</p>
      </div>`).join('');
  }

  if (recomendadas.length > 0) {
    html += '<p style="font-size:0.8rem;font-weight:700;color:#22C55E;text-transform:uppercase;letter-spacing:0.04em;margin:0.75rem 0 0.5rem">Recomendadas</p>';
    html += recomendadas.map(v => `
      <div style="background:#F0FDF4;border-left:3px solid #22C55E;border-radius:0 8px 8px 0;padding:0.75rem;margin-bottom:0.5rem">
        <strong style="font-size:0.875rem">${v.nombre}</strong>
        <p style="color:var(--muted);font-size:0.8rem;margin-top:0.2rem">${v.desc}</p>
      </div>`).join('');
  }

  if (d.nota) {
    html += `<p style="font-size:0.8rem;color:var(--muted);margin-top:0.75rem;padding:0.75rem;background:var(--bg);border-radius:8px">💡 ${d.nota}</p>`;
  }

  document.getElementById('vp-vacunas').innerHTML = html;
}

calcVP();
</script>