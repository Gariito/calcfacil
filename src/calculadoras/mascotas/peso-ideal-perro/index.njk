<script>
function calcPID() {
  const razaVal = document.getElementById('pid-raza').value.split(',');
  const sexo    = document.getElementById('pid-sexo').value;
  const pesoActual = parseFloat(document.getElementById('pid-peso-actual').value);
  const razaNombre = document.getElementById('pid-raza').options[document.getElementById('pid-raza').selectedIndex].text;

  const minM = parseFloat(razaVal[1]);
  const maxM = parseFloat(razaVal[2]);
  const minH = parseFloat(razaVal[3]);
  const maxH = parseFloat(razaVal[4]);

  const min = sexo === 'm' ? minM : minH;
  const max = sexo === 'm' ? maxM : maxH;
  const media = (min + max) / 2;
  const sexoLabel = sexo === 'm' ? 'macho' : 'hembra';

  document.getElementById('pid-res').innerHTML =
    `${razaNombre} (${sexoLabel}): ${min}–${max} kg
    <small>Rango de peso orientativo · Valor medio de referencia: ${media.toFixed(1)} kg</small>`;

  if (!isNaN(pesoActual) && pesoActual > 0) {
    let estado, color, consejo;
    const pct = ((pesoActual - media) / media * 100).toFixed(0);

    if (pesoActual < min * 0.9) {
      estado = 'Muy por debajo del rango orientativo';
      color = '#3B82F6';
      consejo = `El peso está por debajo del rango de referencia de esta raza. Esto no determina por sí solo si existe bajo peso: consulta con tu veterinario para valorar su condición corporal.`;
    } else if (pesoActual < min) {
      estado = 'Por debajo del rango orientativo';
      color = '#EAB308';
      consejo = 'El peso es algo inferior al rango de referencia. Ten en cuenta su constitución y condición corporal; si tienes dudas, consulta con tu veterinario.';
    } else if (pesoActual <= max) {
      estado = 'Dentro del rango orientativo';
      color = '#22C55E';
      consejo = 'El peso está dentro del rango de referencia para esta raza y sexo. Esto no garantiza por sí solo una condición corporal ideal: también importan la musculatura y la distribución de la grasa.';
    } else if (pesoActual <= max * 1.1) {
      estado = 'Por encima del rango orientativo';
      color = '#EAB308';
      consejo = 'El peso supera ligeramente el rango de referencia. Valora su constitución y condición corporal antes de cambiar la alimentación.';
    } else {
      estado = 'Bastante por encima del rango orientativo';
      color = '#EF4444';
      consejo = 'El peso supera el rango de referencia de esta raza. No confirma por sí solo que tenga sobrepeso; conviene valorar su condición corporal con un veterinario.';
    }

    document.getElementById('pid-comp').style.display = 'block';
    document.getElementById('pid-comp-card').innerHTML = `
      <h2 style="font-family:var(--font-display);font-size:1rem;font-weight:700;margin-bottom:0.75rem">Comparación del peso actual</h2>
      <p style="font-size:1.1rem;font-weight:700;color:${color};margin-bottom:0.5rem">${estado}</p>
      <p style="font-size:0.875rem;color:var(--muted);margin-bottom:0.5rem">${consejo}</p>
      <p style="font-size:0.825rem;color:var(--muted)">Peso actual: ${pesoActual} kg · Rango de referencia: ${min}–${max} kg · Diferencia respecto al valor medio: ${pct > 0 ? '+' : ''}${pct}%</p>
      <p style="font-size:0.78rem;color:var(--muted);margin-top:0.5rem">Esta comparación es orientativa y no sustituye una valoración veterinaria.</p>`;
  } else {
    document.getElementById('pid-comp').style.display = 'none';
  }
}

calcPID();
</script>