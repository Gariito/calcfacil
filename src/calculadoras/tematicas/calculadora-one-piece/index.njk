<script>

(function() {

    let current = "0";

    let previous = null;

    let operator = null;

    let waitingForNumber = false;


    const display =
        document.getElementById(
            "onepiece-display"
        );


    const operation =
        document.getElementById(
            "onepiece-operation"
        );


    /* ==========================================
       ACTUALIZAR PANTALLA
    ========================================== */

    function updateDisplay() {

        display.textContent = current;

    }


    /* ==========================================
       CALCULAR
    ========================================== */

    function calculateValues(a, b, op) {

        a = Number(a);

        b = Number(b);


        if (op === "+") {

            return a + b;

        }


        if (op === "-") {

            return a - b;

        }


        if (op === "*") {

            return a * b;

        }


        if (op === "/") {

            if (b === 0) {

                return null;

            }

            return a / b;

        }


        return b;

    }


    /* ==========================================
       SÍMBOLO
    ========================================== */

    function getOperatorSymbol(op) {

        if (op === "+") return "+";

        if (op === "-") return "−";

        if (op === "*") return "×";

        if (op === "/") return "÷";

        return op;

    }


    /* ==========================================
       NÚMEROS
    ========================================== */

    window.onepieceNumber = function(number) {

        if (
            current === "Error" ||
            waitingForNumber
        ) {

            current = number;

            waitingForNumber = false;

        } else if (current === "0") {

            current = number;

        } else {

            current += number;

        }


        updateDisplay();

    };


    /* ==========================================
       DECIMAL
    ========================================== */

    window.onepieceDecimal = function() {

        if (current === "Error") {

            current = "0.";

            waitingForNumber = false;

        } else if (waitingForNumber) {

            current = "0.";

            waitingForNumber = false;

        } else if (
            !current.includes(".")
        ) {

            current += ".";

        }


        updateDisplay();

    };


    /* ==========================================
       OPERADORES
    ========================================== */

    window.onepieceOperator = function(op) {

        if (current === "Error") {

            return;

        }


        if (
            operator !== null &&
            !waitingForNumber
        ) {

            const result =
                calculateValues(
                    previous,
                    current,
                    operator
                );


            if (result === null) {

                current = "Error";

                previous = null;

                operator = null;

                operation.textContent = "";

                updateDisplay();

                return;

            }


            current = String(result);

        }


        previous = current;

        operator = op;

        waitingForNumber = true;


        operation.textContent =
            previous +
            " " +
            getOperatorSymbol(op);


        updateDisplay();

    };


    /* ==========================================
       IGUAL
    ========================================== */

    window.onepieceCalculate = function() {

        if (
            operator === null ||
            previous === null
        ) {

            return;

        }


        const result =
            calculateValues(
                previous,
                current,
                operator
            );


        if (result === null) {

            current = "Error";

        } else {

            current = String(result);

        }


        previous = null;

        operator = null;

        waitingForNumber = true;

        operation.textContent = "";


        updateDisplay();

    };


    /* ==========================================
       BORRAR TODO
    ========================================== */

    window.onepieceClear = function() {

        current = "0";

        previous = null;

        operator = null;

        waitingForNumber = false;

        operation.textContent = "";


        updateDisplay();

    };


    /* ==========================================
       BORRAR ÚLTIMO
    ========================================== */

    window.onepieceDelete = function() {

        if (
            current === "Error" ||
            current.length <= 1
        ) {

            current = "0";

        } else {

            current =
                current.slice(
                    0,
                    -1
                );

        }


        updateDisplay();

    };


    /* ==========================================
       PORCENTAJE
    ========================================== */

    window.onepiecePercent = function() {

        if (current === "Error") {

            return;

        }


        const value =
            Number(current);


        if (!isNaN(value)) {

            current =
                String(value / 100);

            updateDisplay();

        }

    };


})();

</script>