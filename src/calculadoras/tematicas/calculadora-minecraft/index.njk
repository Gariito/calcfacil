    gap: 7px;
}


/* ==========================================
   BOTONES
========================================== */

.minecraft-button {

    position: relative;

    min-height: 59px;

    padding: 0;

    border: 3px solid #202020;

    border-radius: 5px;

    overflow: hidden;

    color: #fff;

    font-size: 1.12rem;

