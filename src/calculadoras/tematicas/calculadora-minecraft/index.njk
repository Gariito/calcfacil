    cursor: pointer;

    background-color: #555;

    background-size: cover;

    background-position: center;

    box-shadow:
        inset 2px 2px 0 rgba(255,255,255,0.28),
        inset -3px -3px 0 rgba(0,0,0,0.45),
        0 2px 0 #111;

    transition:
        transform 0.08s ease,
        filter 0.08s ease;
}


/*
   Capa oscura encima de la textura.
   Hace que los símbolos blancos
   sean siempre fáciles de leer.
*/

.minecraft-button::before {

    content: "";

    position: absolute;

    inset: 0;

    background: rgba(0,0,0,0.22);

    pointer-events: none;
}


/*
   Símbolo del botón.
   Siempre queda por encima
   de la imagen.
*/

.minecraft-button span {

    position: relative;

    z-index: 2;

    color: #fff;

    font-size: 1.2rem;

    font-weight: 900;

    text-shadow:
        2px 2px 0 #111,
        -1px -1px 0 rgba(0,0,0,0.5);
}


.minecraft-button:hover {

    filter: brightness(1.12);
}


.minecraft-button:active {

    transform: translateY(2px);

    box-shadow:
        inset 2px 2px 0 rgba(0,0,0,0.35),
        inset -2px -2px 0 rgba(255,255,255,0.12);
}


