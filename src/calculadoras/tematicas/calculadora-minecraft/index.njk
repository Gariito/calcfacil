<style>

/* ==========================================
   CALCULADORA MINECRAFT
========================================== */

.minecraft-calculator {
    position: relative;
    max-width: 430px;
    margin: 28px auto;

    padding: 18px;

    border-radius: 18px;

    /*
       Imagen de fondo de Minecraft.
       Puedes sustituirla por cualquier imagen
       que quieras utilizar como escenario.
    */

    background:
        linear-gradient(
            rgba(15, 25, 15, 0.25),
            rgba(10, 20, 10, 0.45)
        ),
        url("/img/minecraft/minecraft-background.png")
        center center / cover no-repeat;

    border: 4px solid #222;

    box-shadow:
        0 8px 22px rgba(0,0,0,0.35),
        inset 0 0 0 2px rgba(255,255,255,0.15);

    overflow: hidden;
}


/* Capa de textura */

.minecraft-calculator::after {
    content: "";

    position: absolute;

    inset: 0;

    pointer-events: none;

    background-image:
        linear-gradient(
            45deg,
            rgba(255,255,255,0.025) 25%,
            transparent 25%,
            transparent 75%,
            rgba(255,255,255,0.025) 75%
        );

    background-size: 8px 8px;
}


/* Contenido */

.minecraft-content {
    position: relative;
    z-index: 2;
}


/* ==========================================
   CABECERA
========================================== */

.minecraft-header {

    display: flex;

