function getDBData(edad, sexo) {
  const tabla = sexo === 'n' ? DB_NINOS : DB_NINAS;
  const keys  = Object.keys(tabla).map(Number).sort((a,b)=>a-b);
  let resultado = tabla[0];
  for (const k of keys) {
    if (edad >= k) resultado = tabla[k];
  }
  return resultado;
}

function getHitos(edad) {
  const keys = Object.keys(DB_HITOS).map(Number).sort((a,b)=>a-b);
  let hito = DB_HITOS[0];
  for (const k of keys) {
    if (edad >= k) hito = DB_HITOS[k];
  }
  return hito;
}

function setDBEdad(m) {
  document.getElementById('db-edad').value = m;
  calcDB();
}

function calcDB() {
  const edad  = parseInt(document.getElementById('db-edad').value);
  const sexo  = document.getElementById('db-sexo').value;
  const pesoActual  = parseFloat(document.getElementById('db-peso-actual').value);
  const tallaActual = parseFloat(document.getElementById('db-talla-actual').value);

  if (isNaN(edad) || edad < 0 || edad > 24) return;

  const d = getDBData(edad, sexo);
  const sexoLabel = sexo === 'n' ? 'niño' : 'niña';
  const edadLabel = edad === 0 ? 'al nacer' : edad === 1 ? '1 mes' : `${edad} meses`;

  document.getElementById('db-res').innerHTML =
    `${sexoLabel === 'niño' ? 'Niño' : 'Niña'} de ${edadLabel} — Peso medio: ${d.peso} kg · Talla media: ${d.talla} cm
    <small>Percentil 50 OMS · Rango normal: ${(d.peso*0.82).toFixed(1)}–${(d.peso*1.18).toFixed(1)} kg · ${(d.talla-5).toFixed(1)}–${(d.talla+5).toFixed(1)} cm</small>`;

  document.getElementById('db-cards-wrap').style.display = 'block';
  document.getElementById('db-cards').innerHTML = `
    <div style="background:var(--accent-light);border:2px solid var(--accent);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--accent);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Peso medio</div>
      <div style="font-size:1.5rem;font-weight:700;color:var(--accent)">${d.peso} kg</div>
      <div style="font-size:0.78rem;color:var(--accent)">${(d.peso*1000).toFixed(0)}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Talla media</div>
      <div style="font-size:1.5rem;font-weight:700;color:var(--accent)">${d.talla} cm</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Perímetro cefálico</div>
      <div style="font-size:1.5rem;font-weight:700;color:var(--accent)">${d.pc} cm</div>
    </div>`;

  if (!isNaN(pesoActual) || !isNaN(tallaActual)) {
    let compHTML = '<h2 style="font-family:var(--font-display);font-size:1rem;font-weight:700;margin-bottom:0.75rem">Comparativa con la media</h2>';
    if (!isNaN(pesoActual)) {
      const diffPeso = ((pesoActual - d.peso) / d.peso * 100).toFixed(1);
      const colorPeso = Math.abs(diffPeso) <= 18 ? '#22C55E' : '#EF4444';
      compHTML += `<p style="font-size:0.875rem;margin-bottom:0.5rem">Peso: <strong style="color:${colorPeso}">${pesoActual} kg</strong> — ${diffPeso > 0 ? '+' : ''}${diffPeso}% respecto a la media (${d.peso} kg)</p>`;
    }
    if (!isNaN(tallaActual)) {
      const diffTalla = (tallaActual - d.talla).toFixed(1);
      const colorTalla = Math.abs(diffTalla) <= 5 ? '#22C55E' : '#EAB308';
      compHTML += `<p style="font-size:0.875rem;margin-bottom:0.5rem">Talla: <strong style="color:${colorTalla}">${tallaActual} cm</strong> — ${diffTalla > 0 ? '+' : ''}${diffTalla} cm respecto a la media (${d.talla} cm)</p>`;
    }
    compHTML += '<p style="font-size:0.78rem;color:var(--muted);margin-top:0.5rem">⚠️ Esta comparativa es orientativa. Consulta siempre a tu pediatra para interpretar el crecimiento de tu bebé.</p>';
    document.getElementById('db-comparativa').style.display = 'block';
    document.getElementById('db-comp-card').innerHTML = compHTML;
  } else {
    document.getElementById('db-comparativa').style.display = 'none';
  }

  document.getElementById('db-hitos-wrap').style.display = 'block';
  document.getElementById('db-hitos').textContent = getHitos(edad);
}
</script>