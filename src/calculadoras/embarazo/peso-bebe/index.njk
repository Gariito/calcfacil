<script>
const PB_DATA = {
  8:{peso:1,long:1.6}, 9:{peso:2,long:2.3}, 10:{peso:4,long:3.1},
  11:{peso:7,long:4.1}, 12:{peso:14,long:5.4}, 13:{peso:23,long:7.4},
  14:{peso:43,long:8.7}, 15:{peso:70,long:10.1}, 16:{peso:100,long:11.6},
  17:{peso:140,long:13.0}, 18:{peso:190,long:14.2}, 19:{peso:240,long:15.3},
  20:{peso:300,long:25.6}, 21:{peso:360,long:26.7}, 22:{peso:430,long:27.8},
  23:{peso:500,long:28.9}, 24:{peso:600,long:30.0}, 25:{peso:660,long:34.6},
  26:{peso:760,long:35.6}, 27:{peso:875,long:36.6}, 28:{peso:1000,long:37.6},
  29:{peso:1150,long:38.6}, 30:{peso:1320,long:39.9}, 31:{peso:1500,long:41.1},
  32:{peso:1700,long:42.4}, 33:{peso:1900,long:43.7}, 34:{peso:2100,long:45.0},
  35:{peso:2380,long:46.2}, 36:{peso:2600,long:47.4}, 37:{peso:2860,long:48.6},
  38:{peso:3000,long:49.8}, 39:{peso:3200,long:50.7}, 40:{peso:3400,long:51.2},
  41:{peso:3600,long:51.7}, 42:{peso:3700,long:52.0}
};

function setPbSemana(s) {
  document.getElementById('pb-semana').value = s;
  calcPesoBebe();
}

function calcPesoBebe() {
  const s = parseInt(document.getElementById('pb-semana').value);
  if (!s || s < 8 || s > 42) return;
  const d = PB_DATA[s];
  if (!d) return;

  const pesoStr = d.peso >= 1000
    ? `${(d.peso/1000).toFixed(2).replace('.',',')} kg`
    : `${d.peso} g`;

  document.getElementById('pb-res').innerHTML =
    `Semana ${s} — Peso medio: ${pesoStr} · Longitud: ${d.long} cm
    <small>Rango normal: ${Math.round(d.peso*0.85)}g – ${Math.round(d.peso*1.15)}g · Valores de referencia OMS</small>`;

  const el = document.getElementById('pb-cards');
  el.style.display = 'grid';
  el.innerHTML = `
    <div style="background:var(--accent-light);border:2px solid var(--accent);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--accent);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Peso medio</div>
      <div style="font-size:1.5rem;font-weight:700;color:var(--accent)">${pesoStr}</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Longitud</div>
      <div style="font-size:1.5rem;font-weight:700;color:var(--accent)">${d.long} cm</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Semana</div>
      <div style="font-size:1.5rem;font-weight:700;color:var(--accent)">${s}</div>
      <div style="font-size:0.78rem;color:var(--muted)">${s<=12?'1er trimestre':s<=26?'2º trimestre':'3er trimestre'}</div>
    </div>`;
}
</script>