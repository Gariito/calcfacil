        <div id="pb-cards" style="display:none;margin-top:1rem;display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem"></div>

        <div class="card" style="margin-top:1.5rem">
          <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem">Peso y longitud del bebé según la semana</h2>
          <table style="width:100%;font-size:0.825rem;border-collapse:collapse">
            <tr style="background:var(--accent-light)">
              <th style="padding:0.6rem 0.75rem;text-align:center;border-bottom:2px solid var(--accent);color:var(--accent)">Semana</th>
              <th style="padding:0.6rem 0.75rem;text-align:right;border-bottom:2px solid var(--accent);color:var(--accent)">Peso medio</th>
              <th style="padding:0.6rem 0.75rem;text-align:right;border-bottom:2px solid var(--accent);color:var(--accent)">Longitud media</th>
              <th style="padding:0.6rem 0.75rem;text-align:left;border-bottom:2px solid var(--accent);color:var(--accent)">Tamaño aprox.</th>
            </tr>
            <tr><td style="padding:0.4rem 0.75rem;text-align:center">12</td><td style="text-align:right">14g</td><td style="text-align:right">5,4cm</td><td>Ciruela</td></tr>
            <tr style="background:var(--bg)"><td style="padding:0.4rem 0.75rem;text-align:center">16</td><td style="text-align:right">100g</td><td style="text-align:right">11,6cm</td><td>Aguacate</td></tr>
            <tr><td style="padding:0.4rem 0.75rem;text-align:center">20</td><td style="text-align:right">300g</td><td style="text-align:right">25cm</td><td>Plátano</td></tr>
            <tr style="background:var(--bg)"><td style="padding:0.4rem 0.75rem;text-align:center">24</td><td style="text-align:right">600g</td><td style="text-align:right">30cm</td><td>Mazorca de maíz</td></tr>
            <tr><td style="padding:0.4rem 0.75rem;text-align:center">28</td><td style="text-align:right">1.000g</td><td style="text-align:right">37cm</td><td>Berenjena</td></tr>
            <tr style="background:var(--bg)"><td style="padding:0.4rem 0.75rem;text-align:center">32</td><td style="text-align:right">1.700g</td><td style="text-align:right">42cm</td><td>Calabacín grande</td></tr>
            <tr><td style="padding:0.4rem 0.75rem;text-align:center">34</td><td style="text-align:right">2.100g</td><td style="text-align:right">45cm</td><td>Melón pequeño</td></tr>
            <tr style="background:var(--bg)"><td style="padding:0.4rem 0.75rem;text-align:center">36</td><td style="text-align:right">2.600g</td><td style="text-align:right">47cm</td><td>Lechuga romana</td></tr>
            <tr><td style="padding:0.4rem 0.75rem;text-align:center">38</td><td style="text-align:right">3.000g</td><td style="text-align:right">50cm</td><td>Puerro grande</td></tr>
            <tr style="background:var(--bg)"><td style="padding:0.4rem 0.75rem;text-align:center">40</td><td style="text-align:right">3.400g</td><td style="text-align:right">51cm</td><td>Sandía pequeña</td></tr>
