            <button onclick="setPbSemana(28)" style="padding:0.3rem 0.75rem;border:1px solid var(--border);border-radius:6px;background:var(--bg);cursor:pointer;font-size:0.825rem;font-family:var(--font-body)">Sem. 28</button>
            <button onclick="setPbSemana(32)" style="padding:0.3rem 0.75rem;border:1px solid var(--border);border-radius:6px;background:var(--bg);cursor:pointer;font-size:0.825rem;font-family:var(--font-body)">Sem. 32</button>
            <button onclick="setPbSemana(36)" style="padding:0.3rem 0.75rem;border:1px solid var(--border);border-radius:6px;background:var(--bg);cursor:pointer;font-size:0.825rem;font-family:var(--font-body)">Sem. 36</button>
            <button onclick="setPbSemana(40)" style="padding:0.3rem 0.75rem;border:1px solid var(--border);border-radius:6px;background:var(--bg);cursor:pointer;font-size:0.825rem;font-family:var(--font-body)">Sem. 40</button>
          </div>

          <div class="result-box" id="pb-res">Introduce la semana de gestación</div>
