<script>
const COLORES_BARRAS = {
  combustible: '#3B82F6',
  seguro: '#8B5CF6',
  impuestos: '#F59E0B',
  mantenimiento: '#22C55E',
  parking: '#EF4444',
  amortizacion: '#EC4899',
  prestamo: '#14B8A6',
  otros: '#6B7280'
};

function toggleSeguro() {
  const tipo = document.getElementById('co-seguro-tipo').value;
  const estimaciones = {
    terceros: 280,
    terceros_plus: 420,
    todo_riesgo: 650,
    manual: null
  };
  if (estimaciones[tipo] !== null) {
    document.getElementById('co-seguro').value = estimaciones[tipo];
  }
  calcCoche();
}

function calcCoche() {
  const combustible = document.getElementById('co-combustible').value;
  const km = parseFloat(document.getElementById('co-km').value)||0;
  const consumo = parseFloat(document.getElementById('co-consumo').value)||0;
  const precioComb = parseFloat(document.getElementById('co-precio-comb').value)||0;
  const seguro = parseFloat(document.getElementById('co-seguro').value)||0;
  const ivtm = parseFloat(document.getElementById('co-ivtm').value)||0;
  const itv = parseFloat(document.getElementById('co-itv').value)||0;
  const aceite = parseFloat(document.getElementById('co-aceite').value)||0;
  const neumaticos = parseFloat(document.getElementById('co-neumaticos').value)||0;
  const reparaciones = parseFloat(document.getElementById('co-reparaciones').value)||0;
  const limpieza = parseFloat(document.getElementById('co-limpieza').value)||0;
  const parking = parseFloat(document.getElementById('co-parking').value)||0;
  const peajes = parseFloat(document.getElementById('co-peajes').value)||0;
  const multas = parseFloat(document.getElementById('co-multas').value)||0;
  const prestamo = parseFloat(document.getElementById('co-prestamo').value)||0;
  const precioCoche = parseFloat(document.getElementById('co-precio').value)||0;
  const anosUso = parseFloat(document.getElementById('co-anos-uso').value)||8;

  // Cálculo combustible mensual
  let gastoCombMensual = 0;
  if (combustible === 'electrico') {
    gastoCombMensual = km * 0.18 * precioComb;
    document.getElementById('co-consumo-label').textContent = 'Consumo (kWh/100km)';
    document.getElementById('co-precio-comb-label').textContent = 'Precio electricidad (€/kWh)';
    document.getElementById('co-consumo').placeholder = '15';
    document.getElementById('co-precio-comb').placeholder = '0.18';
  } else {
    gastoCombMensual = (km * consumo / 100) * precioComb;
    document.getElementById('co-consumo-label').textContent = 'Consumo (L/100km)';
    document.getElementById('co-precio-comb-label').textContent = 'Precio combustible (€/litro)';
  }

  // Amortización mensual
  const amortizacionMensual = precioCoche > 0 ? precioCoche / (anosUso * 12) : 0;

  // Gastos anuales convertidos a mensuales
  const seguroMensual = seguro / 12;
  const ivtmMensual = ivtm / 12;
  const itvMensual = itv / 12;
  const aceiteM = aceite / 12;
  const neumaticoM = neumaticos / 12;
  const reparacionM = reparaciones / 12;
  const limpiezaM = limpieza / 12;
  const multasM = multas / 12;

  const gastos = {
    combustible: gastoCombMensual,
    seguro: seguroMensual,
    impuestos: ivtmMensual + itvMensual,
    mantenimiento: aceiteM + neumaticoM + reparacionM + limpiezaM,
    parking: parking + peajes,
    amortizacion: amortizacionMensual,
    prestamo: prestamo,
    otros: multasM
  };

  const totalMensual = Object.values(gastos).reduce((a, b) => a + b, 0);
  const totalAnual = totalMensual * 12;

  if (totalMensual === 0) return;

  const fmt = n => n.toLocaleString('es-ES', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' €';
  const fmt2 = n => n.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';

  document.getElementById('co-res').innerHTML =
    `Tu coche te cuesta ${fmt(totalMensual)}/mes — ${fmt(totalAnual)}/año
    <small>Coste por km: ${(totalMensual / (km||1)).toFixed(3).replace('.', ',')} €/km · Solo combustible: ${fmt2(gastoCombMensual)}/mes</small>`;

  document.getElementById('co-desglose').style.display = 'block';

  // Cards de resumen
  const etiquetas = {
    combustible: '⛽ Combustible',
    seguro: '🛡️ Seguro',
    impuestos: '📋 Impuestos',
    mantenimiento: '🔧 Mantenimiento',
    parking: '🅿️ Parking/peajes',
    amortizacion: '📉 Amortización',
    prestamo: '💳 Préstamo',
    otros: '📌 Otros'
  };

  document.getElementById('co-resumen-cards').innerHTML = `
    <div class="coche-resumen-item" style="grid-column:span 2;background:var(--accent-light);border-color:var(--accent)">
      <div class="valor" style="font-size:1.5rem">${fmt(totalMensual)}/mes</div>
      <div class="etiqueta" style="color:var(--accent)">Coste total mensual</div>
    </div>
    <div class="coche-resumen-item">
      <div class="valor">${fmt(totalAnual)}</div>
      <div class="etiqueta">Coste anual</div>
    </div>
    <div class="coche-resumen-item">
      <div class="valor">${(totalMensual/(km||1)).toFixed(3).replace('.',',')} €</div>
      <div class="etiqueta">Coste por km</div>
    </div>`;

  // Barras de desglose
  const gastosOrdenados = Object.entries(gastos)
    .filter(([, v]) => v > 0)
    .sort(([, a], [, b]) => b - a);

  const maximo = gastosOrdenados[0]?.[1] || 1;

  document.getElementById('co-barras').innerHTML = `
    <h3 style="font-size:0.9rem;font-weight:600;margin-bottom:0.75rem;margin-top:0.5rem">Desglose mensual</h3>
    ${gastosOrdenados.map(([key, val]) => `
      <div class="coche-barra-item">
        <div class="nombre">${etiquetas[key] || key}</div>
        <div class="barra">
          <div class="barra-fill" style="width:${(val/maximo*100).toFixed(1)}%;background:${COLORES_BARRAS[key]}"></div>
        </div>
        <div class="cantidad" style="color:${COLORES_BARRAS[key]}">${fmt2(val)}</div>
      </div>`).join('')}
    <div class="coche-barra-item" style="border-top:1px solid var(--border);padding-top:0.4rem;margin-top:0.2rem">
      <div class="nombre" style="font-weight:700;color:var(--text)">TOTAL</div>
      <div class="barra"></div>
      <div class="cantidad" style="color:var(--accent);font-weight:700">${fmt2(totalMensual)}</div>
    </div>`;
}
</script>