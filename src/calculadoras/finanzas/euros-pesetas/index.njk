<script>
const CAMBIO = 166.386;

function calcEP() {
  const val = parseFloat(document.getElementById('ep-val').value);
  const dir = document.getElementById('ep-dir').value;

  if (isNaN(val)) {
    document.getElementById('ep-res').textContent = 'Introduce una cantidad';
    return;
  }

  if (dir === 'ep') {
    const pts = val * CAMBIO;

    document.getElementById('ep-res').innerHTML =
      `${pts.toLocaleString('es-ES', {
        maximumFractionDigits: 2
      })} pesetas
      <small>
        ${val.toLocaleString('es-ES')} € × 166,386 =
        ${pts.toLocaleString('es-ES', {
          maximumFractionDigits: 2
        })} pts
      </small>`;
  } else {
    const eur = val / CAMBIO;

    document.getElementById('ep-res').innerHTML =
      `${eur.toLocaleString('es-ES', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 4
      })} euros
      <small>
        ${val.toLocaleString('es-ES')} pts ÷ 166,386 =
        ${eur.toLocaleString('es-ES', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 4
        })} €
      </small>`;
  }
}
</script>