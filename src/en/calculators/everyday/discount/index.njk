<script>
function updateLabel() {
  const tipo = document.getElementById('desc-tipo').value;
  document.getElementById('desc-val-label').textContent = tipo === 'pct' ? 'Discount (%)' : 'Discount ($)';
}

function setDesc(v) {
  document.getElementById('desc-tipo').value = 'pct';
  updateLabel();
  document.getElementById('desc-val').value = v;
  calcDesc();
}

function calcDesc() {
  const precio = parseFloat(document.getElementById('desc-precio').value);
  const tipo = document.getElementById('desc-tipo').value;
  const val = parseFloat(document.getElementById('desc-val').value);
  const resEl = document.getElementById('desc-res');

  if (!precio || isNaN(precio) || !val || isNaN(val)) {
    resEl.textContent = 'Enter the price and discount';
    return;
  }

  let ahorro = 0, final = 0, pct = 0;
  if (tipo === 'pct') {
    ahorro = (precio * val) / 100;
    final = precio - ahorro;
    pct = val;
  } else {
    ahorro = val;
    final = precio - val;
    pct = ((val / precio) * 100).toFixed(1);
  }

  if (final < 0) final = 0;

  resEl.innerHTML = `
    <strong>Final Price: $${final.toFixed(2)}</strong><br>
    <small style="font-size:0.85rem;color:var(--muted)">You Save: $${ahorro.toFixed(2)} (${pct}%) · Original Price: $${precio.toFixed(2)}</small>
  `;
}
</script>