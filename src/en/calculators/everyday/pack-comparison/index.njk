<script>
function comparePacks() {
  const price1    = parseFloat(document.getElementById('pc-price1').value);
  const quantity1 = parseFloat(document.getElementById('pc-quantity1').value);
  const price2    = parseFloat(document.getElementById('pc-price2').value);
  const quantity2 = parseFloat(document.getElementById('pc-quantity2').value);

  if (![price1, quantity1, price2, quantity2].every(Number.isFinite) ||
      price1 < 0 || price2 < 0 || quantity1 <= 0 || quantity2 <= 0) {
    document.getElementById('pc-res').textContent = 'Enter the price and units of both packs';
    document.getElementById('pc-desglose').style.display = 'none';
    return;
  }

  const result1 = price1 / quantity1;
  const result2 = price2 / quantity2;
  const fmt = n => n.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 4 });
  const diff = Math.abs(result1 - result2);
  const pct  = ((Math.abs(result1 - result2) / Math.max(result1, result2)) * 100).toFixed(1);

  let winner, color, msg;
  if (diff < 0.000001) {
    winner = 'both'; color = '#EAB308';
    msg = 'Both packs have the same price per unit.';
  } else if (result1 < result2) {
    winner = '1'; color = 'var(--accent)';
    msg = `Pack 1 has the lower price per unit — ${pct}% cheaper than Pack 2.`;
  } else {
    winner = '2'; color = '#22C55E';
    msg = `Pack 2 has the lower price per unit — ${pct}% cheaper than Pack 1.`;
  }

  document.getElementById('pc-res').innerHTML =
    `<span style="color:${color}">${msg}</span>
    <small>Pack 1: ${fmt(result1)} per unit · Pack 2: ${fmt(result2)} per unit</small>`;

  document.getElementById('pc-desglose').style.display = 'block';
  document.getElementById('pc-cards').innerHTML = `
    <div style="background:${winner==='1'?'var(--accent-light)':'var(--bg)'};border:${winner==='1'?'2px solid var(--accent)':'1px solid var(--border)'};border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:${winner==='1'?'var(--accent)':'var(--muted)'};margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Pack 1 — per unit${winner==='1'?' ✓':''}</div>
      <div style="font-size:1.5rem;font-weight:700;color:${winner==='1'?'var(--accent)':'var(--muted)'}">${fmt(result1)}</div>
      <div style="font-size:0.78rem;color:var(--muted)">${quantity1} units · ${fmt(price1)} total</div>
    </div>
    <div style="background:${winner==='2'?'#F0FDF4':'var(--bg)'};border:${winner==='2'?'2px solid #22C55E':'1px solid var(--border)'};border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:${winner==='2'?'#22C55E':'var(--muted)'};margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Pack 2 — per unit${winner==='2'?' ✓':''}</div>
      <div style="font-size:1.5rem;font-weight:700;color:${winner==='2'?'#22C55E':'var(--muted)'}">${fmt(result2)}</div>
      <div style="font-size:0.78rem;color:var(--muted)">${quantity2} units · ${fmt(price2)} total</div>
    </div>`;
}
</script>