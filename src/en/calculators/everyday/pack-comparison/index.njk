<div style="display:grid;gap:1.25rem">
  <div style="padding:1rem;border:1px solid var(--border);border-radius:8px">
    <h3 style="font-size:1rem;margin:0 0 1rem">Pack 1</h3>

    <label for="pc-price1" style="display:block;margin-bottom:.4rem;font-weight:600">Price</label>
    <input id="pc-price1" type="number" step="0.01" min="0" placeholder="e.g. 4.99"
      style="width:100%;padding:.7rem;border:1px solid var(--border);border-radius:8px;margin-bottom:.8rem">

    <label for="pc-quantity1" style="display:block;margin-bottom:.4rem;font-weight:600">Number of units</label>
    <input id="pc-quantity1" type="number" step="1" min="1" placeholder="e.g. 6"
      style="width:100%;padding:.7rem;border:1px solid var(--border);border-radius:8px">
  </div>

  <div style="padding:1rem;border:1px solid var(--border);border-radius:8px">
    <h3 style="font-size:1rem;margin:0 0 1rem">Pack 2</h3>

    <label for="pc-price2" style="display:block;margin-bottom:.4rem;font-weight:600">Price</label>
    <input id="pc-price2" type="number" step="0.01" min="0" placeholder="e.g. 6.99"
      style="width:100%;padding:.7rem;border:1px solid var(--border);border-radius:8px;margin-bottom:.8rem">

    <label for="pc-quantity2" style="display:block;margin-bottom:.4rem;font-weight:600">Number of units</label>
    <input id="pc-quantity2" type="number" step="1" min="1" placeholder="e.g. 10"
      style="width:100%;padding:.7rem;border:1px solid var(--border);border-radius:8px">
  </div>

  <button onclick="comparePacks()"
    style="width:100%;padding:.8rem;border:0;border-radius:8px;background:var(--accent);color:white;font-weight:700;cursor:pointer">
    Compare packs
  </button>

  <div id="pc-result" style="display:none">
    <table style="width:100%;font-size:.9rem;border-collapse:collapse">
      <tr style="background:var(--accent-light)">
        <th style="padding:.7rem;text-align:left">Pack</th>
        <th style="padding:.7rem;text-align:right">Price per unit</th>
      </tr>
      <tr>
        <td style="padding:.7rem;border-bottom:1px solid var(--border)">Pack 1</td>
        <td id="pc-r1" style="padding:.7rem;text-align:right;border-bottom:1px solid var(--border)"></td>
      </tr>
      <tr>
        <td style="padding:.7rem">Pack 2</td>
        <td id="pc-r2" style="padding:.7rem;text-align:right"></td>
      </tr>
    </table>

    <div id="pc-best" style="margin-top:1rem;padding:1rem;background:var(--accent-light);border-radius:8px;text-align:center;font-weight:700"></div>
  </div>
</div>

<script>
function comparePacks() {
  const price1 = parseFloat(document.getElementById('pc-price1').value);
  const quantity1 = parseFloat(document.getElementById('pc-quantity1').value);
  const price2 = parseFloat(document.getElementById('pc-price2').value);
  const quantity2 = parseFloat(document.getElementById('pc-quantity2').value);

  if (![price1, quantity1, price2, quantity2].every(Number.isFinite) ||
      price1 < 0 || price2 < 0 || quantity1 <= 0 || quantity2 <= 0) {
    document.getElementById('pc-result').style.display = 'none';
    return;
  }

  const result1 = price1 / quantity1;
  const result2 = price2 / quantity2;

  document.getElementById('pc-r1').textContent =
    result1.toLocaleString('en-GB', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 4
    });

  document.getElementById('pc-r2').textContent =
    result2.toLocaleString('en-GB', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 4
    });

  const best = document.getElementById('pc-best');

  if (Math.abs(result1 - result2) < 0.000001) {
    best.textContent = 'Both packs have the same price per unit.';
  } else if (result1 < result2) {
    best.textContent = 'Pack 1 has the lower price per unit.';
  } else {
    best.textContent = 'Pack 2 has the lower price per unit.';
  }

  document.getElementById('pc-result').style.display = 'block';
}
</script>

<div style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border)">
  <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem">How to compare two packs</h2>

  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:.75rem">When two products contain different quantities, comparing only the total price can be misleading. A larger pack is not necessarily cheaper per unit.</p>

  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:.75rem">To compare two packs fairly, divide the price of each pack by the number of units it contains. The resulting unit prices can then be compared directly.</p>

  <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;margin-bottom:1rem">Pack comparison example</h2>

  <p style="color:var(--muted);font-size:0.9rem;line-height:1.8;margin-bottom:0">If a pack of 6 costs $4.80, each unit costs $0.80. If another pack contains 10 units and costs $7, each unit costs $0.70. The second pack costs more overall, but its price per unit is lower.</p>
</div>