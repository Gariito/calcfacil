<script>
function calcWords() {
  const txt = document.getElementById('wc-texto').value;
  if (!txt.trim()) {
    document.getElementById('wc-res').textContent = 'Start typing to see the word count';
    document.getElementById('wc-stats').innerHTML = '';
    return;
  }
  const words = txt.trim().split(/\s+/).filter(w => w.length > 0).length;
  const chars = txt.length;
  const charsNoSpaces = txt.replace(/\s/g,'').length;
  const sentences = txt.split(/[.!?]+/).filter(s => s.trim().length > 0).length;
  const paragraphs = txt.split(/\n+/).filter(p => p.trim().length > 0).length;
  const readTime = Math.ceil(words / 200);

  document.getElementById('wc-res').innerHTML =
    `${words.toLocaleString('en-GB')} words · ${chars.toLocaleString('en-GB')} characters
    <small>Estimated reading time: ~${readTime} min</small>`;

  document.getElementById('wc-stats').innerHTML = `
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.4rem;font-weight:700;color:var(--accent)">${words.toLocaleString('en-GB')}</div>
      <div style="font-size:0.8rem;color:var(--muted)">Words</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.4rem;font-weight:700;color:var(--accent)">${chars.toLocaleString('en-GB')}</div>
      <div style="font-size:0.8rem;color:var(--muted)">Characters (with spaces)</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.4rem;font-weight:700;color:var(--accent)">${charsNoSpaces.toLocaleString('en-GB')}</div>
      <div style="font-size:0.8rem;color:var(--muted)">Characters (no spaces)</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.4rem;font-weight:700;color:var(--accent)">${sentences}</div>
      <div style="font-size:0.8rem;color:var(--muted)">Sentences</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.4rem;font-weight:700;color:var(--accent)">${paragraphs}</div>
      <div style="font-size:0.8rem;color:var(--muted)">Paragraphs</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:0.75rem;text-align:center">
      <div style="font-size:1.4rem;font-weight:700;color:var(--accent)">${readTime} min</div>
      <div style="font-size:0.8rem;color:var(--muted)">Reading time</div>
    </div>`;
}
</script>