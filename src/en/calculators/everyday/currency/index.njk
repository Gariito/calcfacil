<script>
function setDesc(v) {
  document.getElementById('desc-tipo').value = 'pct';
  document.getElementById('desc-val-label').textContent = 'Discount (%)';
  document.getElementById('desc-val').value = v;
  calcDesc();
}

function toggleDescType() {
  const tipo = document.getElementById('desc-tipo').value;
  document.getElementById('desc-val-label').textContent =
    tipo === 'pct' ? 'Discount (%)' : 'Fixed discount amount';
  calcDesc();
}

function calcDesc() {
  const precio = parseFloat(document.getElementById('desc-precio').value);
  const tipo   = document.getElementById('desc-tipo').value;
  const val    = parseFloat(document.getElementById('desc-val').value);

  if (isNaN(precio) || precio <= 0 || isNaN(val)) {
    document.getElementById('desc-res').textContent = 'Enter the price and discount';
    document.getElementById('desc-desglose').style.display = 'none';
    return;
  }

  let ahorro, final, pct;
  if (tipo === 'pct') {
    ahorro = precio * val / 100;
    final  = precio - ahorro;
    pct    = val;
  } else {
    ahorro = val;
    final  = precio - val;
    pct    = (val / precio * 100).toFixed(1);
  }

  if (final < 0) {
    document.getElementById('desc-res').textContent = 'Discount cannot exceed the original price';
    document.getElementById('desc-desglose').style.display = 'none';
    return;
  }

  const fmt = n => n.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

  document.getElementById('desc-res').innerHTML =
    `Final price: ${fmt(final)}
    <small>You save ${fmt(ahorro)} (${pct}% off) · Original: ${fmt(precio)}</small>`;

  document.getElementById('desc-original-val').textContent = fmt(precio);
  document.getElementById('desc-ahorro-val').textContent   = '−' + fmt(ahorro);
  document.getElementById('desc-final-val').textContent    = fmt(final);
  document.getElementById('desc-desglose').style.display   = 'grid';
}
</script>