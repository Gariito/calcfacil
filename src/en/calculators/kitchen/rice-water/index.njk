<script>
function calcRice() {
  const grams = parseFloat(document.getElementById('rice-grams').value);
  const ratio = parseFloat(document.getElementById('rice-ratio').value);
  if (!grams || grams <= 0) return;

  const water = Math.round(grams * ratio);
  const cups = (grams / 185).toFixed(1);
  const waterCups = (water / 240).toFixed(1);

  document.getElementById('rice-res').innerHTML =
    `${water.toLocaleString('en-GB')} ml of water
    <small>For ${grams}g of rice · Ratio ${ratio}:1 · ~${waterCups} cups of water for ~${cups} cups of rice</small>`;

  document.getElementById('rice-desglose').style.display = 'block';
  document.getElementById('rice-cards').innerHTML = `
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Rice</div>
      <div style="font-size:1.5rem;font-weight:700;color:var(--muted)">${grams}g</div>
      <div style="font-size:0.75rem;color:var(--muted)">~${cups} cups</div>
    </div>
    <div style="background:var(--accent-light);border:2px solid var(--accent);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--accent);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Water needed</div>
      <div style="font-size:1.5rem;font-weight:700;color:var(--accent)">${water} ml</div>
      <div style="font-size:0.75rem;color:var(--accent)">~${waterCups} cups</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Cooked yield</div>
      <div style="font-size:1.5rem;font-weight:700;color:var(--muted)">~${Math.round(grams*2.5)}g</div>
      <div style="font-size:0.75rem;color:var(--muted)">approx. cooked weight</div>
    </div>`;
}
</script>