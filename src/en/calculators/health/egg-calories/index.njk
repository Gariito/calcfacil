<script>
const EC_BASE = {
  43: { kcal: 62, prot: 5.3, grasas: 4.2, carbs: 0.4, clara_kcal: 13, yema_kcal: 42 },
  53: { kcal: 77, prot: 6.5, grasas: 5.3, carbs: 0.6, clara_kcal: 17, yema_kcal: 55 },
  63: { kcal: 91, prot: 7.7, grasas: 6.2, carbs: 0.7, clara_kcal: 20, yema_kcal: 65 },
  73: { kcal: 106, prot: 9.0, grasas: 7.3, carbs: 0.8, clara_kcal: 24, yema_kcal: 76 }
};

const EC_COCCION = {
  boiled: {
    label: 'Boiled / Hard-boiled',
    extra: 0
  },
  soft: {
    label: 'Soft-boiled',
    extra: 0
  },
  poached: {
    label: 'Poached',
    extra: 0
  },
  scrambled: {
    label: 'Scrambled (no added fat)',
    extra: 0
  },
  fried_light: {
    label: 'Fried (little oil)',
    extras: { 43: 28, 53: 35, 63: 42, 73: 49 }
  },
  fried_normal: {
    label: 'Fried (more oil)',
    extras: { 43: 48, 53: 60, 63: 72, 73: 84 }
  },
  raw: {
    label: 'Raw',
    extra: 0
  }
};

function calcEC() {
  const tamanoVal = document.getElementById('ec-tamano').value;
  const coccion = document.getElementById('ec-coccion').value;
  const cantidadInput = document.getElementById('ec-cantidad');
  const cantidad = Number(cantidadInput.value);

  const base = EC_BASE[tamanoVal];
  const coc = EC_COCCION[coccion];

  const resultado = document.getElementById('ec-res');
  const nutri = document.getElementById('ec-nutri');
  const partesWrap = document.getElementById('ec-partes-wrap');

  if (!base || !coc) {
    resultado.textContent = 'Please select a valid egg size and cooking method.';
    nutri.style.display = 'none';
    partesWrap.style.display = 'none';
    return;
  }

  if (
    cantidadInput.value.trim() === '' ||
    !Number.isInteger(cantidad) ||
    cantidad < 1 ||
    cantidad > 100
  ) {
    resultado.textContent = 'Enter a whole number between 1 and 100 eggs.';
    nutri.style.display = 'none';
    partesWrap.style.display = 'none';
    return;
  }

  const extra = coc.extras ? coc.extras[tamanoVal] : coc.extra;
  const kcalUno = Math.round(base.kcal + extra);
  const kcalTotal = kcalUno * cantidad;

  // These macros describe the eggs themselves. Added cooking fat
  // is represented in the calorie estimate but not in the macro totals.
  const protTotal = (base.prot * cantidad).toFixed(1);
  const grasTotal = (base.grasas * cantidad).toFixed(1);
  const carbTotal = (base.carbs * cantidad).toFixed(1);

  const eggsStr = cantidad === 1 ? '1 egg' : `${cantidad} eggs`;
  const sizeLabel = {
    43: 'S',
    53: 'M',
    63: 'L',
    73: 'XL'
  }[tamanoVal];

  resultado.innerHTML = `
    <strong>${kcalTotal} kcal</strong> — ${eggsStr} (${sizeLabel}), ${coc.label}
    <small>Protein: ${protTotal}g · Fat: ${grasTotal}g · Carbohydrates: ${carbTotal}g</small>
    ${extra > 0 ? '<small>Calories from added cooking fat are estimated; fat and other nutrient totals show the eggs only.</small>' : ''}
  `;

  nutri.style.display = 'block';

  document.getElementById('ec-cards').innerHTML = `
    <div style="background:var(--accent-light);border:2px solid var(--accent);border-radius:10px;padding:0.85rem;text-align:center;min-width:0">
      <div style="font-size:0.75rem;color:var(--accent);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Calories</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${kcalTotal}</div>
      <div style="font-size:0.78rem;color:var(--accent)">${kcalUno} kcal/egg</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center;min-width:0">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Protein</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${protTotal}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">${base.prot}g/egg</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center;min-width:0">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Fat</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${grasTotal}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">${base.grasas}g/egg, excluding added cooking fat</div>
    </div>
  `;

  partesWrap.style.display = 'block';

  document.getElementById('ec-partes').innerHTML = `
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center;min-width:0">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Egg white only</div>
      <div style="font-size:1.4rem;font-weight:700;color:var(--accent)">${base.clara_kcal * cantidad} kcal</div>
      <div style="font-size:0.78rem;color:var(--muted)">~${(base.prot * 0.55 * cantidad).toFixed(1)}g protein</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center;min-width:0">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Yolk only</div>
      <div style="font-size:1.4rem;font-weight:700;color:var(--accent)">${base.yema_kcal * cantidad} kcal</div>
      <div style="font-size:0.78rem;color:var(--muted)">~${(base.prot * 0.42 * cantidad).toFixed(1)}g protein</div>
    </div>
  `;
}

calcEC();
</script>