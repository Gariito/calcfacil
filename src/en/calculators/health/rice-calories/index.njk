<script>
function setRC(g) {
  document.getElementById('rc-gramos').value = g;
  calcRC();
}

function calcRC() {
  const tipoSelect = document.getElementById('rc-tipo');
  const tipoVal = tipoSelect.value.split(',').map(Number);
  const gramosInput = document.getElementById('rc-gramos');
  const valor = gramosInput.value.trim();
  const g = Number(valor);

  const resultado = document.getElementById('rc-res');
  const nutri = document.getElementById('rc-nutri');
  const cards = document.getElementById('rc-cards');

  if (valor === '' || !Number.isFinite(g) || g <= 0) {
    resultado.textContent = 'Enter an amount greater than 0g to calculate the nutritional values.';
    nutri.style.display = 'none';
    cards.innerHTML = '';
    return;
  }

  const kcal100 = tipoVal[0];
  const prot100 = tipoVal[1];
  const carb100 = tipoVal[2];
  const fibr100 = tipoVal[3];
  const gras100 = tipoVal[4];

  const kcal = Math.round(kcal100 * g / 100);
  const prot = (prot100 * g / 100).toFixed(1);
  const carb = (carb100 * g / 100).toFixed(1);
  const fibr = (fibr100 * g / 100).toFixed(1);
  const gras = (gras100 * g / 100).toFixed(1);

  const tipoNombre = tipoSelect.options[tipoSelect.selectedIndex].text;
  const fmt = value => Number(value).toLocaleString('en-US', {
    maximumFractionDigits: 1
  });

  resultado.innerHTML = `
    <strong>${kcal} kcal — ${fmt(g)}g of ${tipoNombre}</strong>
    <small style="display:block;margin-top:0.45rem">
      Carbohydrates: ${carb}g · Protein: ${prot}g · Fat: ${gras}g · Fibre: ${fibr}g
    </small>
  `;

  nutri.style.display = 'block';
  cards.innerHTML = `
    <div style="background:var(--accent-light);border:2px solid var(--accent);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--accent);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Calories</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${kcal}</div>
      <div style="font-size:0.78rem;color:var(--accent)">kcal</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Carbohydrates</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${carb}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">for ${fmt(g)}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Protein</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${prot}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">for ${fmt(g)}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Fat</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${gras}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">for ${fmt(g)}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Fibre</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${fibr}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">for ${fmt(g)}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Per 100g</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${kcal100}</div>
      <div style="font-size:0.78rem;color:var(--muted)">kcal/100g</div>
    </div>
  `;
}
</script>