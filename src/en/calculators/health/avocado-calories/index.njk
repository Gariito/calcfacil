<script>
const AV_KCAL = 160;
const AV_GRASAS = 14.7;
const AV_CARBS = 8.5;
const AV_PROT = 2.0;
const AV_FIBRA = 6.7;
const AV_SAT = 2.1;

function toggleModeAV() {
  const modo = document.getElementById('av-modo').value;

  document.getElementById('av-wrap-gramos').style.display =
    modo === 'gramos' ? 'block' : 'none';

  document.getElementById('av-wrap-tamano').style.display =
    modo === 'tamano' ? 'block' : 'none';

  document.getElementById('av-wrap-porcion').style.display =
    modo === 'porcion' ? 'block' : 'none';

  calcAV();
}

function calcAV() {
  const modo = document.getElementById('av-modo').value;
  let g = 0;

  if (modo === 'gramos') {
    g = parseFloat(document.getElementById('av-gramos').value);
  } else if (modo === 'tamano') {
    g = parseFloat(document.getElementById('av-tamano').value);
  } else {
    g = parseFloat(document.getElementById('av-porcion').value);
  }

  if (!Number.isFinite(g) || g <= 0) {
    document.getElementById('av-res').textContent =
      'Enter a valid amount of avocado to calculate its nutritional values.';
    document.getElementById('av-nutri').style.display = 'none';
    return;
  }

  const kcal = Math.round(AV_KCAL * g / 100);
  const grasas = (AV_GRASAS * g / 100).toFixed(1);
  const carbs = (AV_CARBS * g / 100).toFixed(1);
  const prot = (AV_PROT * g / 100).toFixed(1);
  const fibra = (AV_FIBRA * g / 100).toFixed(1);
  const sat = (AV_SAT * g / 100).toFixed(1);
  const peso = Number.isInteger(g) ? g : g.toFixed(1);

  document.getElementById('av-res').innerHTML =
    `${kcal} kcal — ${peso}g of avocado flesh
    <small>Fat: ${grasas}g · Carbohydrates: ${carbs}g · Protein: ${prot}g · Fibre: ${fibra}g</small>`;

  document.getElementById('av-nutri').style.display = 'block';

  document.getElementById('av-cards').innerHTML = `
    <div style="background:var(--accent-light);border:2px solid var(--accent);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--accent);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Calories</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${kcal}</div>
      <div style="font-size:0.78rem;color:var(--accent)">kcal</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Fat</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${grasas}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">${sat}g saturated fat</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Carbohydrates</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${carbs}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">${fibra}g fibre</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Protein</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${prot}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">per ${peso}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Fibre</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${fibra}g</div>
      <div style="font-size:0.78rem;color:var(--muted)">per ${peso}g</div>
    </div>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:0.85rem;text-align:center">
      <div style="font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem;text-transform:uppercase;letter-spacing:0.04em">Calories per 100g</div>
      <div style="font-size:1.8rem;font-weight:700;color:var(--accent)">${AV_KCAL}</div>
      <div style="font-size:0.78rem;color:var(--muted)">kcal/100g</div>
    </div>`;
}

toggleModeAV();
</script>