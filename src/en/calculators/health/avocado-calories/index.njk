            <tr style="background:var(--bg)"><td style="padding:0.5rem 0.75rem">🍎 Apple</td><td style="text-align:right">52 kcal</td></tr>
            <tr><td style="padding:0.5rem 0.75rem">🍊 Orange</td><td style="text-align:right">47 kcal</td></tr>
            <tr style="background:var(--bg)"><td style="padding:0.5rem 0.75rem">🍓 Strawberry</td><td style="text-align:right">32 kcal</td></tr>
